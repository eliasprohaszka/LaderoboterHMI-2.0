<!-- MaintenanceGrid - Touch Optimized Layout -->
<div class="maintenance-grid">
    @ChildContent
</div>

<style>
    .maintenance-grid {
        --grid-gap: 0.75rem;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: repeat(5, 1fr);
        gap: var(--grid-gap);
        height: 100%;
        max-height: 100%;
    }

    /* Ensure all grid items stretch to fill their cell */
    .maintenance-grid > * {
        min-height: 0;
        height: 100%;
    }
</style>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

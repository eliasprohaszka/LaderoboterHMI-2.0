<!-- MaintenanceGrid - Vertical layout optimized -->
<div class="maintenance-grid grid grid-cols-2 gap-4 h-full max-h-full">
    @ChildContent
</div>

<style>
    .maintenance-grid {
        grid-template-rows: repeat(5, 1fr);
    }
</style>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

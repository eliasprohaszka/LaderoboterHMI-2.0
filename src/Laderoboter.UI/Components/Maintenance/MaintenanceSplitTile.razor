<!-- MaintenanceSplitTile - Touch Optimized -->
<div class="split-tile-container @(FullWidth ? "col-span-2" : "")">
    <button @onclick="HandleClickLeft"
            disabled="@(DisabledLeft || IsLoadingLeft)"
            class="split-tile-btn @VariantClassLeft">
        <div class="tile-icon-wrapper">
            @if (IsLoadingLeft)
            {
                <div class="spinner"></div>
            }
            else
            {
                <Blazicon Svg="@IconLeft" class="tile-icon" />
            }
        </div>
        <span class="tile-label">@LabelLeft</span>
        @if (!string.IsNullOrEmpty(SublabelLeft))
        {
            <span class="tile-sublabel">@SublabelLeft</span>
        }
    </button>

    <button @onclick="HandleClickRight"
            disabled="@(DisabledRight || IsLoadingRight)"
            class="split-tile-btn @VariantClassRight">
        <div class="tile-icon-wrapper">
            @if (IsLoadingRight)
            {
                <div class="spinner"></div>
            }
            else
            {
                <Blazicon Svg="@IconRight" class="tile-icon" />
            }
        </div>
        <span class="tile-label">@LabelRight</span>
        @if (!string.IsNullOrEmpty(SublabelRight))
        {
            <span class="tile-sublabel">@SublabelRight</span>
        }
    </button>
</div>

<style>
    .split-tile-container {
        display: flex;
        gap: 0.75rem;
        height: 100%;
        width: 100%;
    }

    /* FullWidth tiles need same gap as grid column-gap */
    .split-tile-container.col-span-2 {
        gap: 0.75rem;
    }

    .split-tile-btn {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1rem;
        min-height: 80px;
        border: none;
        border-radius: 16px;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        transition: transform 150ms ease, box-shadow 150ms ease;
    }

    /* Glassmorphism base for primary variant */
    .split-tile-btn.variant-primary {
        background: linear-gradient(135deg, rgba(0, 85, 128, 0.9) 0%, rgba(0, 61, 92, 0.95) 100%);
        color: white;
        box-shadow: 0 4px 16px rgba(0, 61, 92, 0.3),
                    inset 0 1px 0 rgba(255, 255, 255, 0.15);
    }

    .split-tile-btn.variant-secondary {
        background: linear-gradient(135deg, rgba(100, 116, 139, 0.9) 0%, rgba(71, 85, 105, 0.95) 100%);
        color: white;
        box-shadow: 0 4px 12px rgba(71, 85, 105, 0.3),
                    inset 0 1px 0 rgba(255, 255, 255, 0.15);
    }

    .split-tile-btn.variant-danger {
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.9) 0%, rgba(220, 38, 38, 0.95) 100%);
        color: white;
        box-shadow: 0 4px 16px rgba(220, 38, 38, 0.3),
                    inset 0 1px 0 rgba(255, 255, 255, 0.15);
    }

    /* Subtle shine overlay */
    .split-tile-btn::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 50%;
        background: linear-gradient(180deg,
            rgba(255, 255, 255, 0.12) 0%,
            rgba(255, 255, 255, 0) 100%);
        pointer-events: none;
        border-radius: 16px 16px 0 0;
    }

    /* Touch feedback */
    .split-tile-btn:active:not(:disabled) {
        transform: scale(0.97);
    }

    .split-tile-btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    .tile-icon-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
    }

    .tile-icon {
        width: 40px;
        height: 40px;
    }

    .tile-label {
        font-family: 'Outfit', sans-serif;
        font-size: 0.9rem;
        font-weight: 600;
        text-align: center;
        letter-spacing: 0.01em;
    }

    .tile-sublabel {
        font-size: 0.75rem;
        opacity: 0.85;
        text-align: center;
    }

    .spinner {
        width: 32px;
        height: 32px;
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

@code {
    // Layout
    [Parameter] public bool FullWidth { get; set; }

    // Left button
    [Parameter, EditorRequired] public SvgIcon IconLeft { get; set; } = default!;
    [Parameter, EditorRequired] public string LabelLeft { get; set; } = "";
    [Parameter] public string? SublabelLeft { get; set; }
    [Parameter] public bool DisabledLeft { get; set; }
    [Parameter] public bool IsLoadingLeft { get; set; }
    [Parameter] public string VariantLeft { get; set; } = "primary";
    [Parameter] public EventCallback OnClickLeft { get; set; }

    // Right button
    [Parameter, EditorRequired] public SvgIcon IconRight { get; set; } = default!;
    [Parameter, EditorRequired] public string LabelRight { get; set; } = "";
    [Parameter] public string? SublabelRight { get; set; }
    [Parameter] public bool DisabledRight { get; set; }
    [Parameter] public bool IsLoadingRight { get; set; }
    [Parameter] public string VariantRight { get; set; } = "primary";
    [Parameter] public EventCallback OnClickRight { get; set; }

    private string VariantClassLeft => VariantLeft switch
    {
        "secondary" => "variant-secondary",
        "danger" => "variant-danger",
        _ => "variant-primary"
    };

    private string VariantClassRight => VariantRight switch
    {
        "secondary" => "variant-secondary",
        "danger" => "variant-danger",
        _ => "variant-primary"
    };

    private async Task HandleClickLeft()
    {
        if (OnClickLeft.HasDelegate)
            await OnClickLeft.InvokeAsync();
    }

    private async Task HandleClickRight()
    {
        if (OnClickRight.HasDelegate)
            await OnClickRight.InvokeAsync();
    }
}

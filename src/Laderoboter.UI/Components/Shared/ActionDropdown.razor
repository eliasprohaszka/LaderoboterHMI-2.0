@using Blazicons

<div class="relative">
    <!-- Trigger Button -->
    <button
        class="p-2 rounded-lg text-white font-semibold transition-all duration-200 robot-control-btn shadow-lg bg-primary flex items-center justify-center"
        @onclick="ToggleMenu"
        @onclick:stopPropagation="true">
        <div class="icon-wrapper @(isOpen ? "rotated" : "")">
            <Blazicon Svg="Lucide.EllipsisVertical" class="w-5 h-5" />
        </div>
    </button>

    <!-- Dropdown Menu -->
    @if (isOpen || _isClosing)
    {
        <!-- Backdrop -->
        <div class="fixed inset-0 z-40" @onclick="CloseMenuAnimated"></div>

        <!-- Menu -->
        <div class="dropdown-menu @(_isClosing ? "closing" : "") absolute right-0 top-full mt-2 bg-white rounded-xl shadow-2xl border border-gray-200 overflow-hidden min-w-[200px] z-50">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool isOpen = false;
    private bool _isClosing = false;

    private async Task ToggleMenu()
    {
        if (isOpen)
        {
            await CloseMenuAnimated();
        }
        else
        {
            isOpen = true;
        }
    }

    private async Task CloseMenuAnimated()
    {
        if (_isClosing) return;
        _isClosing = true;
        isOpen = false;
        StateHasChanged();
        await Task.Delay(200);
        _isClosing = false;
    }

    public void Close()
    {
        _ = CloseMenuAnimated();
    }
}

@inject ITranslationService T

@if (IsVisible)
{
    <div class="dialog-overlay" @onclick="OnCancel">
        <div class="dialog" @onclick:stopPropagation="true">
            <div class="dialog-header">
                <div class="flex items-center gap-2">
                    <div class="p-2 bg-green-100 rounded-lg">
                        <Blazicon Svg="Lucide.Check" class="w-5 h-5 text-green-600" />
                    </div>
                    <h3 class="dialog-title">@T.Translate("changeMode.end")</h3>
                </div>
                <button class="close-button" @onclick="OnCancel">×</button>
            </div>

            <div class="dialog-body">
                <p class="mb-4">
                    @T.Translate("changeMode.endQuestion", PaletteId)
                </p>
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-3 text-sm text-blue-800">
                    <p class="font-medium mb-1">@T.Translate("changeMode.note")</p>
                    <ul class="list-disc list-inside space-y-1">
                        <li>@T.Translate("changeMode.doorMustBeClosed")</li>
                        <li>@T.Translate("changeMode.paletteActivated")</li>
                        <li>@T.Translate("changeMode.robotCanAccess")</li>
                    </ul>
                </div>
            </div>

            <div class="dialog-footer">
                <button class="btn btn-secondary" @onclick="OnCancel">
                    @T.Translate("common.cancel")
                </button>
                <button class="btn btn-success" @onclick="OnConfirm">
                    @T.Translate("changeMode.end")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public int PaletteId { get; set; }
    [Parameter] public EventCallback OnConfirmed { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    private async Task OnConfirm()
    {
        await OnConfirmed.InvokeAsync();
    }

    private async Task OnCancel()
    {
        await OnCancelled.InvokeAsync();
    }
}

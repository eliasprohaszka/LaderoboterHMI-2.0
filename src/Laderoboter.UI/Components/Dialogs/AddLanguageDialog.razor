@inject ITranslationService T

@if (IsVisible)
{
    <div class="dialog-overlay" @onclick="OnCancel">
        <div class="dialog" @onclick:stopPropagation="true">
            <div class="dialog-header">
                <h3 class="dialog-title">@T.Translate("translations.addLanguage")</h3>
                <button class="close-button" @onclick="OnCancel">×</button>
            </div>

            <div class="dialog-body">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">@T.Translate("translations.languageCode")</label>
                        <input type="text"
                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                               placeholder="en, fr, es..."
                               @bind="LanguageCode" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">@T.Translate("translations.languageName")</label>
                        <input type="text"
                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                               placeholder="English, French..."
                               @bind="LanguageName" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">@T.Translate("translations.nativeName")</label>
                        <input type="text"
                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                               placeholder="English, Français..."
                               @bind="NativeName" />
                    </div>
                </div>
            </div>

            <div class="dialog-footer">
                <button class="btn btn-secondary" @onclick="OnCancel">
                    @T.Translate("common.cancel")
                </button>
                <button class="btn btn-primary" @onclick="OnConfirm">
                    @T.Translate("common.save")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }
    [Parameter] public EventCallback<(string Code, string Name, string NativeName)> OnConfirmed { get; set; }

    private string LanguageCode { get; set; } = "";
    private string LanguageName { get; set; } = "";
    private string NativeName { get; set; } = "";

    protected override void OnParametersSet()
    {
        if (IsVisible)
        {
            LanguageCode = "";
            LanguageName = "";
            NativeName = "";
        }
    }

    private async Task OnConfirm()
    {
        if (!string.IsNullOrWhiteSpace(LanguageCode) &&
            !string.IsNullOrWhiteSpace(LanguageName) &&
            !string.IsNullOrWhiteSpace(NativeName))
        {
            await OnConfirmed.InvokeAsync((LanguageCode, LanguageName, NativeName));
        }
    }

    private async Task OnCancel()
    {
        await OnCancelled.InvokeAsync();
    }
}

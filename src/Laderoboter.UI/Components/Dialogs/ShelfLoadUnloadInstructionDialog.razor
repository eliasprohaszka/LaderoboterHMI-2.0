@inject ITranslationService T

@if (IsVisible)
{
    <div class="dialog-overlay">
        <div class="dialog max-w-md" @onclick:stopPropagation="true">
            <div class="dialog-header">
                <div class="flex items-center gap-3">
                    <div class="p-2 rounded-lg @(IsLoadMode ? "bg-[#004F7C]/10" : "bg-orange-100")">
                        @if (IsLoadMode)
                        {
                            <Blazicon Svg="Lucide.ArrowDownToLine" class="w-5 h-5 text-[#004F7C]" />
                        }
                        else
                        {
                            <Blazicon Svg="Lucide.ArrowUpFromLine" class="w-5 h-5 text-orange-600" />
                        }
                    </div>
                    <div>
                        <h3 class="dialog-title">@(IsLoadMode ? "Werkstück beladen" : "Werkstück entladen")</h3>
                        <p class="dialog-subtitle">Zielposition: @TargetPositionId</p>
                    </div>
                </div>
            </div>

            <div class="dialog-body">
                <!-- Progress Steps -->
                <div class="space-y-4 mb-6">
                    <!-- Step 1 -->
                    <div class="flex items-start gap-3">
                        @if (CurrentStep > 1)
                        {
                            <div class="w-8 h-8 rounded-full bg-green-500 flex items-center justify-center flex-shrink-0">
                                <Blazicon Svg="Lucide.Check" class="w-4 h-4 text-white" />
                            </div>
                        }
                        else
                        {
                            <div class="w-8 h-8 rounded-full bg-[#004F7C] flex items-center justify-center flex-shrink-0">
                                <span class="text-white text-sm font-semibold">1</span>
                            </div>
                        }
                        <div class="pt-1">
                            <p class="@(CurrentStep >= 1 ? "step-text" : "step-text-inactive")">
                                @(IsLoadMode
                                    ? "Öffnen Sie die Beladetür und legen Sie den Werkstückträger hinein."
                                    : "Öffnen Sie die Beladetür und entnehmen Sie den Werkstückträger.")
                            </p>
                        </div>
                    </div>

                    <!-- Step 2 -->
                    <div class="flex items-start gap-3">
                        @if (CurrentStep > 2)
                        {
                            <div class="w-8 h-8 rounded-full bg-green-500 flex items-center justify-center flex-shrink-0">
                                <Blazicon Svg="Lucide.Check" class="w-4 h-4 text-white" />
                            </div>
                        }
                        else if (CurrentStep == 2)
                        {
                            <div class="w-8 h-8 rounded-full bg-[#004F7C] flex items-center justify-center flex-shrink-0">
                                <span class="text-white text-sm font-semibold">2</span>
                            </div>
                        }
                        else
                        {
                            <div class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center flex-shrink-0">
                                <span class="text-gray-500 text-sm font-semibold">2</span>
                            </div>
                        }
                        <div class="pt-1">
                            <p class="@(CurrentStep >= 2 ? "step-text" : "step-text-inactive")">
                                Schließen Sie die Beladetür und bestätigen Sie.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Current Step Indicator -->
                <div class="info-box @(CurrentStep == 1 ? "blue" : "green")">
                    @if (CurrentStep == 1)
                    {
                        <Blazicon Svg="Lucide.Info" class="w-4 h-4 text-blue-700" />
                        <span>Führen Sie Schritt 1 aus und klicken Sie auf "Weiter"</span>
                    }
                    else
                    {
                        <Blazicon Svg="Lucide.CircleCheck" class="w-4 h-4 text-green-700" />
                        <span>Bestätigen Sie den Vorgang</span>
                    }
                </div>
            </div>

            <div class="dialog-footer">
                <button class="btn btn-secondary" @onclick="OnCancelClick">
                    Abbrechen
                </button>
                @if (CurrentStep == 1)
                {
                    <button class="btn btn-primary" @onclick="OnNextClick">
                        Weiter
                    </button>
                }
                else
                {
                    <button class="btn btn-primary" @onclick="OnConfirmClick">
                        Bestätigen
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public bool IsLoadMode { get; set; }
    [Parameter] public string TargetPositionId { get; set; } = "";
    [Parameter] public int CurrentStep { get; set; } = 1;
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task OnNextClick()
    {
        await OnNext.InvokeAsync();
    }

    private async Task OnConfirmClick()
    {
        await OnConfirm.InvokeAsync();
    }

    private async Task OnCancelClick()
    {
        await OnCancel.InvokeAsync();
    }
}

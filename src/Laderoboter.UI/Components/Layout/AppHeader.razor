@inject IRobotService RobotService
@inject NavigationManager Navigation
@inject ITranslationService T
@inject IAuthStateService AuthState
@inject IAuthorizationService Authorization
@implements IDisposable

<header class="fanuc-header text-slate-800 shadow-lg border-b-4 relative">
    <div class="mx-auto px-6 pt-2 pb-0">
        <div class="flex items-center justify-between">
            <!-- Logo und Titel (Links) -->
            <div class="flex items-end space-x-4">
                <img src="img/logo-2.png"
                     class="w-32 relative z-10 cursor-pointer"
                     alt="GH Logo"
                     style="margin-bottom: -2px" />
                <div class="pb-4">
                    <h1 class="text-xl font-bold leading-tight">@T.Translate("header.title")</h1>
                    <p class="text-primary/80 text-sm">@T.Translate("header.subtitle")</p>
                </div>
            </div>

            <!-- Status und Zeit (Rechts) -->
            <div class="hidden md:flex items-center space-x-8">
                <!-- Error Warning Icon -->
                @if (hasActiveError)
                {
                    <div class="text-right">
                        <button @onclick="ShowCurrentError"
                                class="p-2 rounded-lg bg-red-100 border border-red-200 transition-all duration-200"
                                title="@T.Translate("header.showRobotError")">
                            <Blazicon Svg="Lucide.CircleAlert"
                                      class="w-5 h-5 text-red-600" />
                        </button>
                    </div>
                }

                <!-- System Status -->
                <div class="text-right">
                    <div class="text-xs uppercase tracking-wider text-slate-700 font-medium opacity-80 mb-1">
                        @T.Translate("header.systemStatus")
                    </div>
                    <div class="flex items-center justify-end space-x-4">
                        <!-- Robot Status -->
                        <div class="flex items-center space-x-2">
                            <span class="font-semibold text-sm">@T.Translate("header.robot")</span>
                            <div
                                class="w-3 h-3 rounded-full status-indicator @(RobotService.IsConnected ? "bg-green-500" : "bg-red-500")">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Zeit und Datum -->
                <div class="text-right">
                    <div class="text-xs uppercase tracking-wider text-slate-700 font-medium opacity-80 mb-1">
                        @T.Translate("header.currentTime")
                    </div>
                    <div class="font-mono text-xl font-bold leading-none">
                        @currentTime
                    </div>
                    <div class="text-xs text-slate-700 opacity-70 mt-0.5">
                        @currentDate
                    </div>
                </div>

                <!-- User Info -->
                @if (AuthState.IsAuthenticated)
                {
                    <div class="text-right relative">
                        <button @onclick="ToggleUserMenu"
                                class="flex items-center space-x-2 p-2 rounded-lg hover:bg-white/30 transition-colors">
                            <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center">
                                <Blazicon Svg="Lucide.User" class="w-4 h-4 text-white" />
                            </div>
                            <div class="text-left">
                                <div class="text-sm font-semibold">@(AuthState.CurrentUser?.Name ?? AuthState.CurrentUser?.PersonalNumber)</div>
                                <div class="text-xs text-slate-600">@GetRoleDisplayName(AuthState.CurrentUser?.Role)</div>
                            </div>
                            <Blazicon Svg="Lucide.ChevronDown" class="w-4 h-4 text-slate-600" />
                        </button>

                        @if (_showUserMenu)
                        {
                            <div class="absolute right-0 top-full mt-1 bg-white rounded-lg shadow-lg border border-gray-200 py-1 min-w-40 z-50">
                                @if (Authorization.IsAdmin())
                                {
                                    <button @onclick="NavigateToUserManagement"
                                            class="w-full px-4 py-2 text-left text-sm hover:bg-gray-100 flex items-center space-x-2">
                                        <Blazicon Svg="Lucide.Users" class="w-4 h-4" />
                                        <span>@T.Translate("header.userManagement")</span>
                                    </button>
                                    <div class="border-t border-gray-100 my-1"></div>
                                }
                                <button @onclick="Logout"
                                        class="w-full px-4 py-2 text-left text-sm hover:bg-gray-100 flex items-center space-x-2 text-red-600">
                                    <Blazicon Svg="Lucide.LogOut" class="w-4 h-4" />
                                    <span>@T.Translate("header.logout")</span>
                                </button>
                            </div>
                        }
                    </div>
                }

                <!-- Navigation Menu -->
                <div class="flex items-center space-x-3">
                    @if (showNavigationMenu)
                    {
                        <div class="flex items-center space-x-3 transition-all duration-300">
                            <!-- Dashboard Button -->
                            <button @onclick='() => NavigateTo("/")'
                                    class="@GetNavButtonClass("/") p-3 rounded-lg text-white font-semibold transition-all duration-200 robot-control-btn shadow-lg"
                                    title="@T.Translate("header.dashboard")">
                                <Blazicon Svg="Lucide.House" class="w-5 h-5" />
                            </button>

                            <!-- Settings Button -->
                            <button @onclick='() => NavigateTo("/settings")'
                                    class="@GetNavButtonClass("/settings") p-3 rounded-lg text-white font-semibold transition-all duration-200 robot-control-btn shadow-lg"
                                    title="@T.Translate("header.settings")">
                                <Blazicon Svg="Lucide.Settings" class="w-5 h-5" />
                            </button>

                            <!-- Maintenance Button -->
                            <button @onclick='() => NavigateTo("/maintenance")'
                                    class="@GetNavButtonClass("/maintenance") p-3 rounded-lg text-white font-semibold transition-all duration-200 robot-control-btn shadow-lg"
                                    title="@T.Translate("header.maintenance")">
                                <Blazicon Svg="Lucide.Wrench" class="w-5 h-5" />
                            </button>
                        </div>
                    }

                    <!-- Menu Toggle Button -->
                    <button @onclick="ToggleNavigationMenu"
                            class="p-3 rounded-lg bg-primary text-white font-semibold robot-control-btn navigation-toggle">
                        <Blazicon Svg="Lucide.Menu" class="w-5 h-5" />
                    </button>
                </div>
            </div>
        </div>
    </div>
</header>

@code {
    private string currentTime = "";
    private string currentDate = "";
    private bool showNavigationMenu = false;
    private bool hasActiveError = false;
    private bool _showUserMenu = false;
    private System.Threading.Timer? timer;

    protected override void OnInitialized()
    {
        UpdateDateTime();
        timer = new System.Threading.Timer(_ =>
        {
            UpdateDateTime();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));

        RobotService.StatusChanged += OnStatusChanged;
        T.LanguageChanged += OnLanguageChanged;
        AuthState.AuthStateChanged += OnAuthStateChanged;
    }

    private void UpdateDateTime()
    {
        var now = DateTime.Now;
        currentTime = now.ToString("HH:mm:ss");
        currentDate = now.ToString("dd.MM.yyyy");
    }

    private void OnStatusChanged(object? sender, Laderoboter.Core.Events.RobotStatusChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnLanguageChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnAuthStateChanged(object? sender, User? user)
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleNavigationMenu()
    {
        showNavigationMenu = !showNavigationMenu;
        _showUserMenu = false;
    }

    private void ToggleUserMenu()
    {
        _showUserMenu = !_showUserMenu;
    }

    private void NavigateTo(string path)
    {
        showNavigationMenu = false;
        _showUserMenu = false;
        Navigation.NavigateTo(path);
    }

    private void NavigateToUserManagement()
    {
        _showUserMenu = false;
        Navigation.NavigateTo("/users");
    }

    private async Task Logout()
    {
        _showUserMenu = false;
        await AuthState.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    private string GetNavButtonClass(string path)
    {
        var currentPath = new Uri(Navigation.Uri).AbsolutePath;
        return currentPath == path
            ? "bg-green-600"
            : "bg-primary";
    }

    private string GetRoleDisplayName(UserRole? role) => role switch
    {
        UserRole.Admin => T.Translate("users.role.admin"),
        UserRole.Einrichter => T.Translate("users.role.einrichter"),
        UserRole.Bediener => T.Translate("users.role.bediener"),
        _ => ""
    };

    private void ShowCurrentError()
    {
        // TODO: Show error dialog
    }

    public void Dispose()
    {
        timer?.Dispose();
        RobotService.StatusChanged -= OnStatusChanged;
        T.LanguageChanged -= OnLanguageChanged;
        AuthState.AuthStateChanged -= OnAuthStateChanged;
    }
}

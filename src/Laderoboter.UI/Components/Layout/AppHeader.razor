@inject IRobotService RobotService
@inject IRobotAlarmService AlarmService
@inject IRegisterErrorService RegisterErrorService
@inject NavigationManager Navigation
@inject ITranslationService T
@inject IAuthStateService AuthState
@inject IAuthorizationService Authorization
@implements IDisposable

<header class="fanuc-header">
    <div class="header-container">
        <!-- Logo und Titel (Links) -->
        <div class="header-brand">
            <img src="img/logo-2.png"
                 class="header-logo"
                 alt="GH Logo" />
            <div class="header-titles">
                <h1 class="header-title">@T.Translate("header.title")</h1>
                <p class="header-subtitle">@T.Translate("header.subtitle")</p>
            </div>
        </div>

        <!-- Status und Zeit (Rechts) -->
        <div class="header-actions">
            <!-- Robot Alarm Icon - Touch friendly (shows for both FANUC alarms and R80 errors) -->
            @if (HasAnyError)
            {
                <button @onclick="ShowAlarmDialog"
                        class="header-error-btn @GetAlarmButtonClass()"
                        title="@T.Translate("header.showRobotError")">
                    <Blazicon Svg="Lucide.TriangleAlert" class="w-5 h-5" />
                </button>
            }

            <!-- System Status (immer sichtbar) -->
            <div class="header-status">
                <span class="status-label">@T.Translate("header.robot")</span>
                <div class="status-indicator @(RobotService.IsConnected ? "status-online" : "status-offline")"></div>
            </div>

            <!-- Zeit und Datum (immer sichtbar) -->
            <div class="header-time">
                <div class="time-display">@currentTime</div>
                <div class="date-display">@currentDate</div>
            </div>

            <!-- Navigation Buttons (animiert) -->
            <div class="nav-buttons-container @(showNavigationMenu ? "nav-open" : "nav-closed")">
                <div class="nav-buttons">
                    <!-- Dashboard Button - Visible for all users -->
                    <button @onclick='() => NavigateTo("/")'
                            class="robot-control-btn btn-icon @GetNavButtonClass("/")"
                            title="@T.Translate("header.dashboard")">
                        <Blazicon Svg="Lucide.LayoutGrid" class="w-5 h-5" />
                    </button>

                    <!-- Settings Button - Einrichter and above -->
                    @if (Authorization.CanAccessSettings())
                    {
                        <button @onclick='() => NavigateTo("/settings")'
                                class="robot-control-btn btn-icon @GetNavButtonClass("/settings")"
                                title="@T.Translate("header.settings")">
                            <Blazicon Svg="Lucide.Settings" class="w-5 h-5" />
                        </button>
                    }

                    <!-- Maintenance Button - Einrichter and above -->
                    @if (Authorization.CanAccessMaintenance())
                    {
                        <button @onclick='() => NavigateTo("/maintenance")'
                                class="robot-control-btn btn-icon @GetNavButtonClass("/maintenance")"
                                title="@T.Translate("header.maintenance")">
                            <Blazicon Svg="Lucide.Wrench" class="w-5 h-5" />
                        </button>
                    }

                    <!-- User Button -->
                    @if (AuthState.IsAuthenticated)
                    {
                        <div class="header-user">
                            <button @onclick="ToggleUserMenu"
                                    class="robot-control-btn btn-icon btn-primary"
                                    title="@(AuthState.CurrentUser?.Name ?? AuthState.CurrentUser?.PersonalNumber)">
                                <Blazicon Svg="Lucide.User" class="w-5 h-5" />
                            </button>

                            @if (_showUserMenu || _isUserMenuClosing)
                            {
                                <div class="user-dropdown @(_isUserMenuClosing ? "closing" : "") glass-card">
                                    <div class="dropdown-header">
                                        <div class="dropdown-name">@(AuthState.CurrentUser?.Name ?? AuthState.CurrentUser?.PersonalNumber)</div>
                                        <div class="dropdown-role">@GetRoleDisplayName(AuthState.CurrentUser?.Role)</div>
                                    </div>
                                    @if (Authorization.CanAccessUserManagement())
                                    {
                                        <button @onclick="NavigateToUserManagement"
                                                class="dropdown-item">
                                            <Blazicon Svg="Lucide.Users" class="w-5 h-5" />
                                            <span>@T.Translate("header.userManagement")</span>
                                        </button>
                                        <div class="dropdown-divider"></div>
                                    }
                                    <button @onclick="Logout"
                                            class="dropdown-item dropdown-item-danger">
                                        <Blazicon Svg="Lucide.LogOut" class="w-5 h-5" />
                                        <span>@T.Translate("header.logout")</span>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Menu Toggle Button -->
            <button @onclick="ToggleNavigationMenu"
                    class="robot-control-btn btn-icon btn-primary">
                <div class="menu-icon-wrapper @(showNavigationMenu ? "menu-open" : "")">
                    <Blazicon Svg="Lucide.Menu" class="w-5 h-5" />
                </div>
            </button>
        </div>
    </div>
</header>

<!-- Robot Alarm Dialog -->
<RobotAlarmDialog IsVisible="_showAlarmDialog"
                  OnClosed="CloseAlarmDialog" />

<!-- Program Running Warning Dialog -->
<ProgramStopDialog IsVisible="_showProgramRunningDialog"
                   OnNavigate="OnProgramStoppedNavigate"
                   OnCancelled="OnCancelNavigation" />

<!-- Maintenance Exit Dialog -->
<MaintenanceExitDialog IsVisible="_showMaintenanceExitDialog"
                       OnNavigate="OnMaintenanceExitNavigate" />

@code {
    private string currentTime = "";
    private string currentDate = "";
    private bool showNavigationMenu = false;
    private bool _showUserMenu = false;
    private bool _isUserMenuClosing = false;
    private bool _showAlarmDialog = false;
    private bool _showProgramRunningDialog = false;
    private bool _showMaintenanceExitDialog = false;
    private string? _pendingNavigationPath = null;
    private System.Threading.Timer? _clockTimer;

    // Combined error state: FANUC alarms OR R80 register errors
    private bool HasAnyError => AlarmService.HasActiveAlarm || RegisterErrorService.HasActiveError;

    protected override void OnInitialized()
    {
        UpdateDateTime();

        // Clock timer - updates every second
        _clockTimer = new System.Threading.Timer(_ =>
        {
            UpdateDateTime();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));

        // Subscribe to events - no polling needed anymore
        RobotService.StatusChanged += OnStatusChanged;
        AlarmService.AlarmStateChanged += OnAlarmStateChanged;
        RegisterErrorService.ErrorChanged += OnRegisterErrorChanged;
        T.LanguageChanged += OnLanguageChanged;
        AuthState.AuthStateChanged += OnAuthStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void UpdateDateTime()
    {
        var now = DateTime.Now;
        currentTime = now.ToString("HH:mm:ss");
        currentDate = now.ToString("dd.MM.yyyy");
    }

    private void OnStatusChanged(object? sender, Laderoboter.Core.Events.RobotStatusChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnAlarmStateChanged(object? sender, RobotAlarmStateChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnRegisterErrorChanged(object? sender, RegisterErrorChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnLanguageChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnAuthStateChanged(object? sender, User? user)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleNavigationMenu()
    {
        showNavigationMenu = !showNavigationMenu;
        _showUserMenu = false;
    }

    private async Task ToggleUserMenu()
    {
        if (_showUserMenu)
        {
            await CloseUserMenuAnimated();
        }
        else
        {
            _showUserMenu = true;
        }
    }

    private async Task CloseUserMenuAnimated()
    {
        if (_isUserMenuClosing) return;
        _isUserMenuClosing = true;
        _showUserMenu = false;
        StateHasChanged();
        await Task.Delay(200);
        _isUserMenuClosing = false;
    }

    private async Task NavigateTo(string path)
    {
        if (_showUserMenu) await CloseUserMenuAnimated();

        var currentPath = new Uri(Navigation.Uri).AbsolutePath;

        // Check if navigating away from main page while program is running
        if (currentPath == "/" && path != "/" && RobotService.Status.IsMainProgramRunning)
        {
            _pendingNavigationPath = path;
            _showProgramRunningDialog = true;
            return;
        }

        // Check if navigating away from maintenance page while robot is connected
        if (currentPath == "/maintenance" && path != "/maintenance" && RobotService.IsConnected)
        {
            _pendingNavigationPath = path;
            _showMaintenanceExitDialog = true;
            return;
        }

        Navigation.NavigateTo(path);
    }

    private void OnProgramStoppedNavigate()
    {
        _showProgramRunningDialog = false;

        if (_pendingNavigationPath != null)
        {
            Navigation.NavigateTo(_pendingNavigationPath);
            _pendingNavigationPath = null;
        }
    }

    private void OnCancelNavigation()
    {
        _showProgramRunningDialog = false;
        _pendingNavigationPath = null;
    }

    private void OnMaintenanceExitNavigate()
    {
        _showMaintenanceExitDialog = false;

        if (_pendingNavigationPath != null)
        {
            Navigation.NavigateTo(_pendingNavigationPath);
            _pendingNavigationPath = null;
        }
    }

    private async Task NavigateToUserManagement()
    {
        await CloseUserMenuAnimated();
        Navigation.NavigateTo("/users");
    }

    private async Task Logout()
    {
        await CloseUserMenuAnimated();
        await AuthState.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    private string GetNavButtonClass(string path)
    {
        var currentPath = new Uri(Navigation.Uri).AbsolutePath;
        return currentPath == path
            ? "bg-green-600"
            : "bg-primary";
    }

    private string GetRoleDisplayName(UserRole? role) => role switch
    {
        UserRole.GHAdmin => T.Translate("users.role.ghadmin"),
        UserRole.Admin => T.Translate("users.role.admin"),
        UserRole.Einrichter => T.Translate("users.role.einrichter"),
        UserRole.Bediener => T.Translate("users.role.bediener"),
        _ => ""
    };

    private void ShowAlarmDialog()
    {
        _showAlarmDialog = true;
    }

    private void CloseAlarmDialog()
    {
        _showAlarmDialog = false;
    }

    private string GetAlarmButtonClass()
    {
        // Check R80 errors first
        if (RegisterErrorService.HasActiveError)
        {
            return RegisterErrorService.IsAcknowledged ? "alarm-acknowledged" : "alarm-active";
        }

        return AlarmService.CurrentState switch
        {
            RobotAlarmState.Active => "alarm-active",
            RobotAlarmState.Acknowledged => "alarm-acknowledged",
            _ => ""
        };
    }

    public void Dispose()
    {
        _clockTimer?.Dispose();
        RobotService.StatusChanged -= OnStatusChanged;
        AlarmService.AlarmStateChanged -= OnAlarmStateChanged;
        RegisterErrorService.ErrorChanged -= OnRegisterErrorChanged;
        T.LanguageChanged -= OnLanguageChanged;
        AuthState.AuthStateChanged -= OnAuthStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}

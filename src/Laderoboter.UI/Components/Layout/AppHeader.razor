@inject IRobotService RobotService
@inject NavigationManager Navigation
@inject ITranslationService T
@inject IAuthStateService AuthState
@inject IAuthorizationService Authorization
@implements IDisposable

<header class="fanuc-header">
    <div class="header-container">
        <!-- Logo und Titel (Links) -->
        <div class="header-brand">
            <img src="img/logo-2.png"
                 class="header-logo"
                 alt="GH Logo" />
            <div class="header-titles">
                <h1 class="header-title">@T.Translate("header.title")</h1>
                <p class="header-subtitle">@T.Translate("header.subtitle")</p>
            </div>
        </div>

        <!-- Status und Zeit (Rechts) -->
        <div class="header-actions">
            <!-- Error Warning Icon - Touch friendly -->
            @if (hasActiveError)
            {
                <button @onclick="ShowCurrentError"
                        class="header-error-btn"
                        title="@T.Translate("header.showRobotError")">
                    <Blazicon Svg="Lucide.CircleAlert" class="w-5 h-5" />
                </button>
            }

            <!-- System Status -->
            <div class="header-status">
                <span class="status-label">@T.Translate("header.robot")</span>
                <div class="status-indicator @(RobotService.IsConnected ? "status-online" : "status-offline")"></div>
            </div>

            <!-- Zeit und Datum -->
            <div class="header-time">
                <div class="time-display">@currentTime</div>
                <div class="date-display">@currentDate</div>
            </div>

            <!-- Navigation Menu - Touch Optimized -->
            <div class="header-nav">
                @if (showNavigationMenu)
                {
                    <div class="nav-buttons">
                        <!-- Dashboard Button -->
                        <button @onclick='() => NavigateTo("/")'
                                class="robot-control-btn btn-icon @GetNavButtonClass("/")"
                                title="@T.Translate("header.dashboard")">
                            <Blazicon Svg="Lucide.House" class="w-5 h-5" />
                        </button>

                        <!-- Settings Button -->
                        <button @onclick='() => NavigateTo("/settings")'
                                class="robot-control-btn btn-icon @GetNavButtonClass("/settings")"
                                title="@T.Translate("header.settings")">
                            <Blazicon Svg="Lucide.Settings" class="w-5 h-5" />
                        </button>

                        <!-- Maintenance Button -->
                        <button @onclick='() => NavigateTo("/maintenance")'
                                class="robot-control-btn btn-icon @GetNavButtonClass("/maintenance")"
                                title="@T.Translate("header.maintenance")">
                            <Blazicon Svg="Lucide.Wrench" class="w-5 h-5" />
                        </button>

                        <!-- User Button -->
                        @if (AuthState.IsAuthenticated)
                        {
                            <div class="header-user">
                                <button @onclick="ToggleUserMenu"
                                        class="robot-control-btn btn-icon btn-primary"
                                        title="@(AuthState.CurrentUser?.Name ?? AuthState.CurrentUser?.PersonalNumber)">
                                    <Blazicon Svg="Lucide.User" class="w-5 h-5" />
                                </button>

                                @if (_showUserMenu)
                                {
                                    <div class="user-dropdown glass-card">
                                        <div class="dropdown-header">
                                            <div class="dropdown-name">@(AuthState.CurrentUser?.Name ?? AuthState.CurrentUser?.PersonalNumber)</div>
                                            <div class="dropdown-role">@GetRoleDisplayName(AuthState.CurrentUser?.Role)</div>
                                        </div>
                                        @if (Authorization.IsAdmin())
                                        {
                                            <button @onclick="NavigateToUserManagement"
                                                    class="dropdown-item">
                                                <Blazicon Svg="Lucide.Users" class="w-5 h-5" />
                                                <span>@T.Translate("header.userManagement")</span>
                                            </button>
                                            <div class="dropdown-divider"></div>
                                        }
                                        <button @onclick="Logout"
                                                class="dropdown-item dropdown-item-danger">
                                            <Blazicon Svg="Lucide.LogOut" class="w-5 h-5" />
                                            <span>@T.Translate("header.logout")</span>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                <!-- Menu Toggle Button -->
                <button @onclick="ToggleNavigationMenu"
                        class="robot-control-btn btn-icon btn-primary">
                    <Blazicon Svg="Lucide.Menu" class="w-5 h-5" />
                </button>
            </div>
        </div>
    </div>
</header>

@code {
    private string currentTime = "";
    private string currentDate = "";
    private bool showNavigationMenu = false;
    private bool hasActiveError = false;
    private bool _showUserMenu = false;
    private System.Threading.Timer? timer;

    protected override void OnInitialized()
    {
        UpdateDateTime();
        timer = new System.Threading.Timer(_ =>
        {
            UpdateDateTime();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));

        RobotService.StatusChanged += OnStatusChanged;
        T.LanguageChanged += OnLanguageChanged;
        AuthState.AuthStateChanged += OnAuthStateChanged;
    }

    private void UpdateDateTime()
    {
        var now = DateTime.Now;
        currentTime = now.ToString("HH:mm:ss");
        currentDate = now.ToString("dd.MM.yyyy");
    }

    private void OnStatusChanged(object? sender, Laderoboter.Core.Events.RobotStatusChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnLanguageChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnAuthStateChanged(object? sender, User? user)
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleNavigationMenu()
    {
        showNavigationMenu = !showNavigationMenu;
        _showUserMenu = false;
    }

    private void ToggleUserMenu()
    {
        _showUserMenu = !_showUserMenu;
    }

    private void NavigateTo(string path)
    {
        showNavigationMenu = false;
        _showUserMenu = false;
        Navigation.NavigateTo(path);
    }

    private void NavigateToUserManagement()
    {
        _showUserMenu = false;
        Navigation.NavigateTo("/users");
    }

    private async Task Logout()
    {
        _showUserMenu = false;
        await AuthState.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    private string GetNavButtonClass(string path)
    {
        var currentPath = new Uri(Navigation.Uri).AbsolutePath;
        return currentPath == path
            ? "bg-green-600"
            : "bg-primary";
    }

    private string GetRoleDisplayName(UserRole? role) => role switch
    {
        UserRole.Admin => T.Translate("users.role.admin"),
        UserRole.Einrichter => T.Translate("users.role.einrichter"),
        UserRole.Bediener => T.Translate("users.role.bediener"),
        _ => ""
    };

    private void ShowCurrentError()
    {
        // TODO: Show error dialog
    }

    public void Dispose()
    {
        timer?.Dispose();
        RobotService.StatusChanged -= OnStatusChanged;
        T.LanguageChanged -= OnLanguageChanged;
        AuthState.AuthStateChanged -= OnAuthStateChanged;
    }
}

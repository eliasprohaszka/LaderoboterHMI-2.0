@using Laderoboter.Core.Services
@inject IRobotService RobotService
@inject ITranslationService T
@implements IDisposable

<!-- SpeedOverrideSidebar - Touch Optimized -->
<div class="speed-sidebar glass-card @(IsCollapsed ? "collapsed" : "expanded")"
     @onclick="HandleSidebarClick">

    @if (IsCollapsed)
    {
        <!-- Collapsed State - Vertical Text with Touch Target -->
        <div class="collapsed-content">
            <div class="vertical-text">
                @T.Translate("speed.title")
            </div>
        </div>
    }
    else
    {
        <!-- Expanded State -->
        <div class="sidebar-header">
            <div class="header-title">
                <Blazicon Svg="Lucide.Gauge" class="header-icon" />
                <h3>@T.Translate("speed.title")</h3>
            </div>
            <button class="collapse-btn robot-control-btn btn-icon"
                    @onclick="ToggleCollapse"
                    @onclick:stopPropagation="true"
                    title="@T.Translate("speed.collapse")">
                <Blazicon Svg="Lucide.ChevronRight" class="w-5 h-5" />
            </button>
        </div>

        <!-- Content -->
        <div class="sidebar-content">
            <!-- Info Text -->
            <div class="sidebar-info">
                @T.Translate("speed.description")
            </div>

            <!-- Speed Control Area -->
            <div class="speed-control">
                <!-- SpeedGauge Component -->
                <div class="gauge-wrapper">
                    <SpeedGauge Value="@SpeedValue"
                                ValueChanged="OnGaugeValueChanged"
                                Disabled="@(!IsConnected || IsUpdating)"
                                Step="5" />
                </div>

                <!-- Large Preset Buttons - Touch Optimized -->
                <div class="preset-grid">
                    @foreach (var preset in Presets)
                    {
                        <button class="preset-btn @(SpeedValue == preset ? "active" : "")"
                                @onclick="() => SetPreset(preset)"
                                @onclick:stopPropagation="true"
                                disabled="@(!IsConnected || IsUpdating)">
                            @preset%
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>

<style>
    .speed-sidebar {
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transition: width 250ms ease;
        cursor: pointer;
    }

    .speed-sidebar.collapsed {
        width: 56px;
    }

    .speed-sidebar.expanded {
        width: 280px;
        cursor: default;
    }

    /* Collapsed state */
    .collapsed-content {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem 0;
    }

    .vertical-text {
        writing-mode: vertical-rl;
        text-orientation: mixed;
        transform: rotate(180deg);
        white-space: nowrap;
        letter-spacing: 0.1em;
        font-family: 'Outfit', sans-serif;
        font-weight: 600;
        font-size: 0.9rem;
        color: #1e293b;
    }

    /* Header */
    .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        background: rgba(255, 255, 255, 0.3);
    }

    .header-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .header-title h3 {
        font-family: 'Outfit', sans-serif;
        font-weight: 600;
        font-size: 0.95rem;
        color: #1e293b;
        margin: 0;
    }

    .header-icon {
        width: 20px;
        height: 20px;
        color: #003d5c;
    }

    .collapse-btn {
        width: 40px !important;
        height: 40px !important;
        min-width: 40px !important;
        min-height: 40px !important;
        padding: 0 !important;
        background: rgba(0, 0, 0, 0.05) !important;
        box-shadow: none !important;
    }

    /* Content */
    .sidebar-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .sidebar-info {
        padding: 0.75rem 1rem;
        font-size: 0.8rem;
        color: #64748b;
        background: rgba(0, 0, 0, 0.03);
        border-bottom: 1px solid rgba(0, 0, 0, 0.04);
    }

    /* Speed control area */
    .speed-control {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: stretch;
        padding: 1rem;
        gap: 1rem;
        min-height: 0;
        overflow: hidden;
    }

    /* Wrapper for the gauge to fill available space */
    .gauge-wrapper {
        flex: 1;
        width: 100%;
        min-height: 120px;
        display: flex;
        align-items: stretch;
        justify-content: center;
    }

    /* Large value display */
    .speed-display {
        text-align: center;
    }

    .speed-value {
        font-family: 'JetBrains Mono', monospace;
        font-size: 3rem;
        font-weight: 700;
        color: #1e293b;
        letter-spacing: -0.02em;
    }

    .speed-unit {
        font-family: 'Outfit', sans-serif;
        font-size: 1.5rem;
        font-weight: 500;
        color: #64748b;
    }

    /* Slider container */
    .slider-container {
        width: 100%;
        padding: 0 0.5rem;
    }

    .speed-slider {
        width: 100%;
        height: 12px;
        -webkit-appearance: none;
        appearance: none;
        background: #e2e8f0;
        border-radius: 6px;
        outline: none;
        cursor: pointer;
    }

    .speed-slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #005580 0%, #003d5c 100%);
        box-shadow: 0 4px 12px rgba(0, 61, 92, 0.3);
        cursor: pointer;
        transition: transform 150ms ease;
    }

    .speed-slider::-webkit-slider-thumb:active {
        transform: scale(1.1);
    }

    .speed-slider::-moz-range-thumb {
        width: 36px;
        height: 36px;
        border: none;
        border-radius: 50%;
        background: linear-gradient(135deg, #005580 0%, #003d5c 100%);
        box-shadow: 0 4px 12px rgba(0, 61, 92, 0.3);
        cursor: pointer;
    }

    .speed-slider:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    /* Preset buttons - Touch Optimized */
    .preset-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.5rem;
        width: 100%;
    }

    .preset-btn {
        min-height: 48px;
        padding: 0.75rem 0.5rem;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.9rem;
        font-weight: 600;
        color: #475569;
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 10px;
        cursor: pointer;
        transition: all 150ms ease;
    }

    .preset-btn:active:not(:disabled) {
        transform: scale(0.95);
    }

    .preset-btn.active {
        background: linear-gradient(135deg, #005580 0%, #003d5c 100%);
        color: white;
        border-color: transparent;
        box-shadow: 0 4px 12px rgba(0, 61, 92, 0.3);
    }

    .preset-btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }
</style>

@code {
    private bool IsCollapsed = true;
    private int SpeedValue = 50;
    private bool IsUpdating = false;
    private int[] Presets = { 25, 50, 75, 100 };

    private bool IsConnected => RobotService.IsConnected;

    private System.Threading.Timer? _refreshTimer;

    protected override void OnInitialized()
    {
        RobotService.StatusChanged += OnStatusChanged;
        T.LanguageChanged += OnLanguageChanged;

        // Nur initialen Wert aus Status lesen (kein SNPX-Aufruf)
        // AutoRefresh wird erst beim Aufklappen gestartet
        if (IsConnected && RobotService.Status.SpeedOverride > 0)
        {
            SpeedValue = RobotService.Status.SpeedOverride;
        }
    }

    private void OnStatusChanged(object? sender, Laderoboter.Core.Events.RobotStatusChangedEventArgs e)
    {
        if (!IsUpdating && e.Status.SpeedOverride > 0)
        {
            SpeedValue = e.Status.SpeedOverride;
        }
        InvokeAsync(StateHasChanged);
    }

    private void OnLanguageChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleSidebarClick()
    {
        if (IsCollapsed)
        {
            await ToggleCollapse();
        }
    }

    private async Task ToggleCollapse()
    {
        IsCollapsed = !IsCollapsed;

        if (!IsCollapsed && IsConnected)
        {
            // Beim Aufklappen den aktuellen Wert vom Roboter laden
            await LoadCurrentSpeedFromRobot();
            // AutoRefresh nur starten wenn aufgeklappt
            StartAutoRefresh();
        }
        else if (IsCollapsed)
        {
            // Beim Zuklappen AutoRefresh stoppen
            StopAutoRefresh();
        }
    }

    private async Task LoadCurrentSpeedFromRobot()
    {
        try
        {
            // Direkt vom Roboter lesen, nicht aus dem gecachten Status
            var currentSpeed = await RobotService.GetSpeedOverrideAsync();
            if (currentSpeed.HasValue && currentSpeed.Value > 0)
            {
                SpeedValue = currentSpeed.Value;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Speed Override] Error loading speed: {ex.Message}");
        }
    }

    private async Task SetPreset(int value)
    {
        SpeedValue = value;
        await ApplySpeed();
    }

    private async Task OnSpeedInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newValue))
        {
            SpeedValue = newValue;
            await ApplySpeed();
        }
    }

    private async Task OnGaugeValueChanged(int newValue)
    {
        SpeedValue = newValue;
        await ApplySpeed();
    }

    private async Task ApplySpeed()
    {
        if (!IsConnected || IsUpdating) return;

        IsUpdating = true;

        try
        {
            await RobotService.SetSpeedOverrideAsync(SpeedValue);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Speed Override] Error applying speed: {ex.Message}");
        }
        finally
        {
            IsUpdating = false;
        }
    }

    private void StartAutoRefresh()
    {
        _refreshTimer?.Dispose();
        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            // Nur aktualisieren wenn aufgeklappt und nicht gerade am Updaten
            if (!IsCollapsed && !IsUpdating && IsConnected)
            {
                var currentSpeed = RobotService.Status.SpeedOverride;
                if (currentSpeed > 0 && currentSpeed != SpeedValue)
                {
                    SpeedValue = currentSpeed;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private void StopAutoRefresh()
    {
        _refreshTimer?.Dispose();
        _refreshTimer = null;
    }

    public void Dispose()
    {
        RobotService.StatusChanged -= OnStatusChanged;
        T.LanguageChanged -= OnLanguageChanged;
        _refreshTimer?.Dispose();
    }
}

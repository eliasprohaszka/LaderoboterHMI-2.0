@using Laderoboter.Core.Models
@inject ITranslationService T

<!-- PaletteCard - Touch Optimized with Glassmorphism -->
<div class="palette-card glass-card h-full flex flex-col">
    <!-- CardHeader - Touch friendly -->
    <div class="palette-header">
        <div class="flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="palette-indicator @(Mode == PaletteMode.Change ? "mode-change" : "mode-active")"></div>
                <h3 class="palette-title">@Title</h3>
            </div>
            <div class="flex items-center gap-3">
                @if (Mode == PaletteMode.Change)
                {
                    <button class="robot-control-btn btn-icon btn-gray"
                            @onclick="OnResetClick"
                            title="@T.Translate("palette.resetAll")">
                        <Blazicon Svg="Lucide.RotateCcw" class="w-5 h-5" />
                    </button>
                }
                <button class="robot-control-btn btn-icon @(Mode == PaletteMode.Change ? "btn-green" : "btn-gray")"
                        @onclick="OnToggleModeClick"
                        disabled="@IsInProgress"
                        title="@ModeToggleTitle">
                    @if (IsInProgress)
                    {
                        <span class="spinner w-5 h-5"></span>
                    }
                    else if (Mode == PaletteMode.Active)
                    {
                        <Blazicon Svg="Lucide.ArrowUpDown" class="w-6 h-6" />
                    }
                    else
                    {
                        <Blazicon Svg="Lucide.Check" class="w-6 h-6" />
                    }
                </button>
            </div>
        </div>
    </div>

    <!-- CardContent - Workpiece Grid -->
    <div class="palette-content">
        <!-- Status Change Processing Indicator -->
        @if (ShowProcessingIndicator)
        {
            <div class="processing-banner">
                <span class="spinner w-4 h-4"></span>
                <span>@T.Translate("palette.changesBeingProcessed")</span>
            </div>
        }

        <div class="workpiece-grid">
            @* Layout: 2 columns, 4 rows
               Left column (top to bottom): P-4, P-3, P-2, P-1
               Right column (top to bottom): P-8, P-7, P-6, P-5 *@
            @foreach (var position in new[] { 4, 8, 3, 7, 2, 6, 1, 5 })
            {
                var workpiece = GetWorkpieceAtPosition(position);
                if (workpiece != null)
                {
                    <WorkpiecePart Workpiece="@workpiece" PaletteId="@PaletteId" OnWorkpieceClick="HandleWorkpieceClick" />
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int PaletteId { get; set; }
    [Parameter] public string Title { get; set; } = "Palette";
    [Parameter] public List<WorkpieceStatus> Workpieces { get; set; } = new();
    [Parameter] public PaletteMode Mode { get; set; } = PaletteMode.Active;
    [Parameter] public bool IsInProgress { get; set; }
    [Parameter] public int ProgressStep { get; set; }
    [Parameter] public bool ShowProcessingIndicator { get; set; }
    [Parameter] public int QueueLength { get; set; }

    [Parameter] public EventCallback OnReset { get; set; }
    [Parameter] public EventCallback OnToggleMode { get; set; }
    [Parameter] public EventCallback<WorkpieceStatus> OnWorkpieceClick { get; set; }

    private string ModeToggleTitle => IsInProgress
        ? T.Translate("changeMode.inProgress", ProgressStep)
        : (Mode == PaletteMode.Active ? T.Translate("changeMode.activate") : T.Translate("changeMode.end"));

    private WorkpieceStatus? GetWorkpieceAtPosition(int position)
    {
        // Position in Workpieces list is 1-based for palette 1 (1-8) or 9-16 for palette 2
        // We need to find by the position modulo
        return Workpieces.FirstOrDefault(w => ((w.Position - 1) % 8) + 1 == position);
    }

    private async Task OnResetClick()
    {
        if (OnReset.HasDelegate)
            await OnReset.InvokeAsync();
    }

    private async Task OnToggleModeClick()
    {
        if (OnToggleMode.HasDelegate)
            await OnToggleMode.InvokeAsync();
    }

    private async Task HandleWorkpieceClick(WorkpieceStatus workpiece)
    {
        if (OnWorkpieceClick.HasDelegate)
            await OnWorkpieceClick.InvokeAsync(workpiece);
    }

    public enum PaletteMode
    {
        Active,
        Change
    }
}

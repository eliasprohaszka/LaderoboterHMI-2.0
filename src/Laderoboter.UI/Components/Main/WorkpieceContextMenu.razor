@using Laderoboter.Core.Models
@using Laderoboter.Core.Services
@using Laderoboter.Core.Constants
@using Laderoboter.Core.Interfaces
@inject IRobotService RobotService
@inject ITranslationService T
@inject IUserActionLogService ActionLog

@if (IsVisible)
{
    <!-- Backdrop -->
    <div class="fixed inset-0 bg-black/20 z-50" @onclick="Close" @onclick:stopPropagation="true">
        <!-- Menu -->
        <div class="absolute bg-white rounded-xl shadow-2xl border border-gray-200 overflow-hidden min-w-[200px]"
             style="@MenuStyle"
             @onclick:stopPropagation="true">

            <!-- Header -->
            <div class="px-4 py-3 bg-gray-50 border-b border-gray-100">
                <div class="font-semibold text-gray-800 text-sm">@WorkpieceId</div>
                <div class="text-xs text-gray-500 mt-1">
                    @T.Translate("workpiece.currentStatus"): @CurrentStatusText
                </div>
            </div>

            <!-- Actions -->
            <div class="py-2">
                <!-- Locked -->
                <button class="w-full px-4 py-3 text-left active:bg-gray-50 active:bg-gray-100 transition-colors flex items-center gap-3"
                        @onclick="() => SetStatus(WorkpieceState.Locked)">
                    <div class="w-4 h-4 rounded-full bg-gray-500"></div>
                    <div>
                        <div class="font-medium text-gray-800 text-sm">@T.Translate("workpieceMenu.lock")</div>
                        <div class="text-xs text-gray-500">@T.Translate("workpieceMenu.lockDescription")</div>
                    </div>
                </button>

                <!-- Unprocessed (Ready) -->
                <button class="w-full px-4 py-3 text-left active:bg-gray-50 active:bg-blue-50 transition-colors flex items-center gap-3"
                        @onclick="() => SetStatus(WorkpieceState.Unprocessed)">
                    <div class="w-4 h-4 rounded-full bg-[#004F7C]"></div>
                    <div>
                        <div class="font-medium text-gray-800 text-sm">@T.Translate("workpieceMenu.reset")</div>
                        <div class="text-xs text-gray-500">@T.Translate("workpieceMenu.resetDescription")</div>
                    </div>
                </button>

                <!-- Processed (Completed) -->
                <button class="w-full px-4 py-3 text-left active:bg-gray-50 active:bg-green-50 transition-colors flex items-center gap-3"
                        @onclick="() => SetStatus(WorkpieceState.Processed)">
                    <div class="w-4 h-4 rounded-full bg-green-600"></div>
                    <div>
                        <div class="font-medium text-gray-800 text-sm">@T.Translate("workpieceMenu.complete")</div>
                        <div class="text-xs text-gray-500">@T.Translate("workpieceMenu.completeDescription")</div>
                    </div>
                </button>
            </div>

            <!-- Cancel -->
            <div class="border-t border-gray-100 p-2">
                <button class="w-full px-4 py-2 text-gray-600 text-sm font-medium active:bg-gray-50 active:bg-gray-100 rounded-lg transition-colors"
                        @onclick="Close">
                    @T.Translate("common.cancel")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public WorkpieceStatus? Workpiece { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<WorkpieceStatus> OnStatusChanged { get; set; }

    private string WorkpieceId => Workpiece != null
        ? $"P{(Workpiece.Position <= 8 ? 1 : 2)}-{((Workpiece.Position - 1) % 8) + 1}"
        : "";

    private string CurrentStatusText => Workpiece?.State switch
    {
        WorkpieceState.Unused => T.Translate("workpiece.empty"),
        WorkpieceState.Locked => T.Translate("workpiece.locked"),
        WorkpieceState.Unprocessed => T.Translate("workpiece.ready"),
        WorkpieceState.Processed => T.Translate("workpiece.processed"),
        WorkpieceState.AtRobot => T.Translate("workpiece.atRobot"),
        WorkpieceState.InMachine => T.Translate("workpiece.inMachine"),
        _ => T.Translate("workpiece.unknown")
    };

    private string MenuStyle => "left: 50%; top: 50%; transform: translate(-50%, -50%);";

    private async Task SetStatus(WorkpieceState newState)
    {
        if (Workpiece == null) return;

        var oldState = Workpiece.State;

        // Workpiece.Position ist 1-16 (1-8 = Palette 1, 9-16 = Palette 2)
        // WriteWorkpieceRegisterWithHandshakeAsync kümmert sich um:
        // - Register-Adresse (R150-R165)
        // - Handshake-Protokoll (R149/R148/R48) wenn MAIN läuft
        // - Direktes Schreiben + R148=1 wenn MAIN nicht läuft

        var success = await RobotService.WriteWorkpieceRegisterWithHandshakeAsync(Workpiece.Position, (int)newState);

        if (success)
        {
            // Update local state
            Workpiece.State = newState;
            await OnStatusChanged.InvokeAsync(Workpiece);

            // Log action
            await ActionLog.LogActionAsync(UserActions.WorkpieceStateChanged,
                $"{WorkpieceId}: {oldState} → {newState}");
        }

        await Close();
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}

@inject IRobotService RobotService
@inject ITranslationService T
@implements IDisposable

<!-- Control Buttons - Touch Optimized Grid -->
<div class="control-grid">
    <!-- Autostart Button - Large and prominent -->
    <button @onclick="StartMainProgram"
            disabled="@(!RobotService.IsConnected || IsMainProgramRunning)"
            class="control-btn @GetAutostartButtonClass()">
        <div class="control-btn-icon">
            <Blazicon Svg="Lucide.Play" class="w-7 h-7" />
        </div>
        <span class="control-btn-label">
            @(IsMainProgramRunning ? T.Translate("program.running") : T.Translate("program.autostart"))
        </span>
    </button>

    <!-- Stop Button - High visibility -->
    <button @onclick="StopCurrentProgram"
            disabled="@(!RobotService.IsConnected)"
            class="control-btn robot-control-btn btn-red">
        <div class="control-btn-icon">
            <Blazicon Svg="Lucide.Square" class="w-7 h-7" />
        </div>
        <span class="control-btn-label">@T.Translate("program.stop")</span>
    </button>

    <!-- Autostop Button -->
    <button @onclick="AutostopProgram"
            disabled="@(!RobotService.IsConnected || !IsMainProgramRunning)"
            class="control-btn @GetAutostopButtonClass()">
        <div class="control-btn-icon">
            <Blazicon Svg="Lucide.CircleStop" class="w-7 h-7" />
        </div>
        <span class="control-btn-label">
            @(IsAutostopActive ? T.Translate("program.stopping") : T.Translate("program.autostop"))
        </span>
    </button>

    <!-- Pause/Resume Button -->
    <button @onclick="PauseCurrentProgram"
            disabled="@(!RobotService.IsConnected || !IsMainProgramRunning)"
            class="control-btn robot-control-btn btn-orange">
        <div class="control-btn-icon">
            @if (IsProgramPaused)
            {
                <Blazicon Svg="Lucide.Play" class="w-7 h-7" />
            }
            else
            {
                <Blazicon Svg="Lucide.Pause" class="w-7 h-7" />
            }
        </div>
        <span class="control-btn-label">
            @(IsProgramPaused ? T.Translate("program.resume") : T.Translate("program.pause"))
        </span>
    </button>

    <!-- Reset Button -->
    <button @onclick="ResetSystem"
            disabled="@(!RobotService.IsConnected)"
            class="control-btn robot-control-btn btn-gray control-btn-span-2">
        <div class="control-btn-icon">
            <Blazicon Svg="Lucide.RotateCcw" class="w-7 h-7" />
        </div>
        <span class="control-btn-label">@T.Translate("program.reset")</span>
    </button>
</div>

@code {
    private bool IsMainProgramRunning;
    private bool IsProgramPaused;
    private bool IsAutostopActive;
    private System.Threading.Timer? _statusPollTimer;

    protected override void OnInitialized()
    {
        RobotService.StatusChanged += OnStatusChanged;
        T.LanguageChanged += OnLanguageChanged;
        _statusPollTimer = new System.Threading.Timer(async _ =>
        {
            await CheckMainProgramStatus();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(2));
    }

    private string GetAutostartButtonClass()
    {
        return IsMainProgramRunning
            ? "robot-control-btn btn-green pulse-green"
            : "robot-control-btn btn-green";
    }

    private string GetAutostopButtonClass()
    {
        return IsAutostopActive
            ? "robot-control-btn btn-yellow pulse-yellow"
            : "robot-control-btn btn-yellow";
    }

    private void OnStatusChanged(object? sender, Laderoboter.Core.Events.RobotStatusChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnLanguageChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private Task CheckMainProgramStatus()
    {
        if (!RobotService.IsConnected)
        {
            IsMainProgramRunning = false;
            IsProgramPaused = false;
            return Task.CompletedTask;
        }
        IsMainProgramRunning = RobotService.Status.IsRunning;
        return Task.CompletedTask;
    }

    private async Task StartMainProgram()
    {
        await RobotService.WriteRegisterAsync(186, 0);
        var result = await RobotService.RunProgramAsync("main");
        if (result) IsMainProgramRunning = true;
    }

    private async Task AutostopProgram()
    {
        IsAutostopActive = true;
        var result = await RobotService.WriteRegisterAsync(186, 1);
        if (!result)
        {
            IsAutostopActive = false;
            await RobotService.StopProgramAsync();
        }
    }

    private async Task PauseCurrentProgram()
    {
        if (!IsProgramPaused)
        {
            await RobotService.PauseProgramAsync();
            IsProgramPaused = true;
        }
        else
        {
            await RobotService.ResumeProgramAsync();
            IsProgramPaused = false;
        }
    }

    private async Task StopCurrentProgram()
    {
        await RobotService.StopProgramAsync();
        IsProgramPaused = false;
        IsMainProgramRunning = false;
    }

    private async Task ResetSystem()
    {
        await RobotService.ResetAsync();
        IsProgramPaused = false;
        IsMainProgramRunning = false;
    }

    public void Dispose()
    {
        RobotService.StatusChanged -= OnStatusChanged;
        T.LanguageChanged -= OnLanguageChanged;
        _statusPollTimer?.Dispose();
    }
}

@using Laderoboter.Core.Models
@inject ITranslationService T

@{
    // Background color based on status (exact match to PalettePart.vue)
    var bgClass = Workpiece.State switch
    {
        WorkpieceState.Processed => "bg-green-600", // completed
        WorkpieceState.AtRobot => "bg-orange-600", // processing
        WorkpieceState.InMachine => "bg-orange-600", // processing
        WorkpieceState.Locked => "bg-gray-600", // locked
        WorkpieceState.Unused => "bg-gray-600", // unused/empty
        WorkpieceState.Unprocessed => "bg-[#004F7C]", // ready
        _ => "bg-[#004F7C]"
    };

    // Shadow class based on status
    var shadowClass = Workpiece.State switch
    {
        WorkpieceState.Processed => "shadow-green",
        WorkpieceState.AtRobot => "shadow-orange",
        WorkpieceState.InMachine => "shadow-orange",
        _ => ""
    };

    // Animation for processing status
    var animClass = Workpiece.State is WorkpieceState.AtRobot or WorkpieceState.InMachine
        ? "animate-hover"
        : "";

    var stateText = Workpiece.State switch
    {
        WorkpieceState.Unused => T.Translate("workpiece.empty"),
        WorkpieceState.Locked => T.Translate("workpiece.locked"),
        WorkpieceState.Unprocessed => T.Translate("workpiece.ready"),
        WorkpieceState.Processed => T.Translate("workpiece.processed"),
        WorkpieceState.AtRobot => T.Translate("workpiece.atRobot"),
        WorkpieceState.InMachine => T.Translate("workpiece.inMachine"),
        _ => T.Translate("workpiece.ready")
    };

    var workpieceId = $"P{(Workpiece.Position <= 8 ? 1 : 2)}-{((Workpiece.Position - 1) % 8) + 1}";
}

<!-- WorkpiecePart (exact match to PalettePart.vue) -->
<div class="workpiece border-white/10 border-[1px] rounded-lg relative overflow-hidden text-xs font-medium transition-all duration-300 cursor-pointer select-none h-full @bgClass @shadowClass @animClass"
     @onclick="OnClick">

    <div class="absolute top-2 left-2 w-3 h-3 rounded-full opacity-70"></div>

    @* @if (Workpiece.SequenceNumber > 0)
    {
        <div class="absolute top-2 right-2 z-20 bg-white rounded-full w-7 h-7 flex items-center justify-center shadow-lg">
            <span class="text-xs font-bold text-gray-800">#@Workpiece.SequenceNumber</span>
        </div>
    } *@

    <div class="absolute top-4 left-4 z-10">
        <div class="font-semibold text-white">@workpieceId</div>
        <div class="text-xs mt-1 text-white/80">@stateText</div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public WorkpieceStatus Workpiece { get; set; } = null!;
    [Parameter] public EventCallback<WorkpieceStatus> OnWorkpieceClick { get; set; }

    private async Task OnClick()
    {
        if (OnWorkpieceClick.HasDelegate)
        {
            await OnWorkpieceClick.InvokeAsync(Workpiece);
        }
    }
}
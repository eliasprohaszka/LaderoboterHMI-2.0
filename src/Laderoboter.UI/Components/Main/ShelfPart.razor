@using Laderoboter.Core.Models
@inject ITranslationService T

@{
    // Status-based CSS class for styling (identical to WorkpiecePart)
    var statusClass = Workpiece?.State switch
    {
        WorkpieceState.Processed => "status-processed",
        WorkpieceState.AtRobot => "status-at-robot",
        WorkpieceState.InMachine => "status-in-machine",
        WorkpieceState.Locked => "status-locked",
        WorkpieceState.Unused => "status-unused",
        WorkpieceState.Unprocessed => "status-unprocessed",
        null => "status-unused",
        _ => "status-unprocessed"
    };

    // Animation for processing status
    var animClass = Workpiece?.State is WorkpieceState.AtRobot or WorkpieceState.InMachine
        ? "animate-hover"
        : "";

    var stateText = Workpiece?.State switch
    {
        WorkpieceState.Unused => T.Translate("workpiece.empty"),
        WorkpieceState.Locked => T.Translate("workpiece.locked"),
        WorkpieceState.Unprocessed => T.Translate("workpiece.ready"),
        WorkpieceState.Processed => T.Translate("workpiece.processed"),
        WorkpieceState.AtRobot => T.Translate("workpiece.atRobot"),
        WorkpieceState.InMachine => T.Translate("workpiece.inMachine"),
        null => T.Translate("workpiece.empty"),
        _ => T.Translate("workpiece.ready")
    };

    // Shelf position ID: R1-1 to R7-4
    var shelfId = $"R{Row}-{Column}";

    var currentState = Workpiece?.State ?? WorkpieceState.Unused;
}

<!-- ShelfPart - Identical design to WorkpiecePart -->
<div class="workpiece @statusClass @animClass"
     @onclick="OnClick">

    <!-- Content container with padding for touch -->
    <div class="workpiece-content">
        <!-- Position ID - Large and clear -->
        <div class="workpiece-id">@shelfId</div>

        <!-- Status indicator with icon -->
        <div class="workpiece-status">
            @switch (currentState)
            {
                case WorkpieceState.Processed:
                    <Blazicon Svg="Lucide.CircleCheck" class="workpiece-status-icon" />
                    break;
                case WorkpieceState.AtRobot:
                    <Blazicon Svg="Lucide.Bot" class="workpiece-status-icon" />
                    break;
                case WorkpieceState.InMachine:
                    <Blazicon Svg="Lucide.Factory" class="workpiece-status-icon" />
                    break;
                case WorkpieceState.Locked:
                    <Blazicon Svg="Lucide.Lock" class="workpiece-status-icon" />
                    break;
                case WorkpieceState.Unused:
                    <Blazicon Svg="Lucide.CircleDashed" class="workpiece-status-icon" />
                    break;
                default:
                    <Blazicon Svg="Lucide.Package" class="workpiece-status-icon" />
                    break;
            }
            <span class="workpiece-status-text">@stateText</span>
        </div>
    </div>

    <!-- Processing indicator overlay -->
    @if (currentState is WorkpieceState.AtRobot or WorkpieceState.InMachine)
    {
        <div class="workpiece-processing-indicator"></div>
    }
</div>

@code {
    [Parameter, EditorRequired] public int Row { get; set; }
    [Parameter, EditorRequired] public int Column { get; set; }
    [Parameter] public WorkpieceStatus? Workpiece { get; set; }
    [Parameter] public EventCallback<WorkpieceStatus> OnWorkpieceClick { get; set; }

    private async Task OnClick()
    {
        if (OnWorkpieceClick.HasDelegate && Workpiece != null)
        {
            await OnWorkpieceClick.InvokeAsync(Workpiece);
        }
    }
}

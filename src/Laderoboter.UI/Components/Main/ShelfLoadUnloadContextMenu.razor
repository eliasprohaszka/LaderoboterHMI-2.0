@using Laderoboter.Core.Models
@inject ITranslationService T

@if (IsVisible)
{
    <div class="menu-overlay" @onclick="Close" @onclick:stopPropagation="true">
        <div class="menu" @onclick:stopPropagation="true">
            <!-- Header -->
            <div class="menu-header">
                <div class="menu-title">R5-1</div>
                <div class="menu-subtitle">Be-/Entladestation</div>
            </div>

            <!-- Actions -->
            <div class="menu-actions">
                <!-- Load (Beladen) -->
                <button class="action-button" @onclick="OnLoadClick">
                    <div class="action-icon load">
                        <Blazicon Svg="Lucide.ArrowDownToLine" class="w-5 h-5 text-[#004F7C]" />
                    </div>
                    <div class="action-text">
                        <div class="title">Beladen</div>
                        <div class="description">Werkstück ins Regal laden</div>
                    </div>
                </button>

                <!-- Unload (Entladen) -->
                <button class="action-button" @onclick="OnUnloadClick">
                    <div class="action-icon unload">
                        <Blazicon Svg="Lucide.ArrowUpFromLine" class="w-5 h-5 text-orange-600" />
                    </div>
                    <div class="action-text">
                        <div class="title">Entladen</div>
                        <div class="description">Werkstück aus Regal entnehmen</div>
                    </div>
                </button>
            </div>

            <!-- Footer -->
            <div class="menu-footer">
                <button class="cancel-button" @onclick="Close">
                    @T.Translate("common.cancel")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnLoadSelected { get; set; }
    [Parameter] public EventCallback OnUnloadSelected { get; set; }

    private async Task OnLoadClick()
    {
        await OnLoadSelected.InvokeAsync();
    }

    private async Task OnUnloadClick()
    {
        await OnUnloadSelected.InvokeAsync();
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}

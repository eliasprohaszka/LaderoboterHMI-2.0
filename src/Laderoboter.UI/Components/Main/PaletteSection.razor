@using Laderoboter.Core.Models
@using static Laderoboter.UI.Components.Main.PaletteCard
@using static Laderoboter.UI.Components.Main.ShelfCard

<!-- PaletteSection - Toggle between Palette and Shelf view -->
<div class="palette-section-container">
    <!-- View Toggle Header -->
    <div class="view-toggle-header">
        <div class="view-toggle-group">
            <button class="view-toggle-btn @(CurrentView == ViewMode.Palette ? "active" : "")"
                    @onclick="() => SetView(ViewMode.Palette)">
                <Blazicon Svg="Lucide.LayoutGrid" class="w-4 h-4" />
                Paletten
            </button>
            <button class="view-toggle-btn @(CurrentView == ViewMode.Shelf ? "active" : "")"
                    @onclick="() => SetView(ViewMode.Shelf)">
                <Blazicon Svg="Lucide.Grid3x3" class="w-4 h-4" />
                Regal
            </button>
        </div>
    </div>

    <!-- Content Area -->
    <div class="palette-content-area">
        @if (CurrentView == ViewMode.Palette)
        {
            <!-- Palette View - Vertical layout: Palette 2 top, Palette 1 bottom -->
            <div class="palette-grid">
            <PaletteCard
                PaletteId="2"
                Title="Palette 2"
                Workpieces="@Palette2Workpieces"
                Mode="@Palette2Mode"
                IsInProgress="@Palette2InProgress"
                ProgressStep="@Palette2ProgressStep"
                ShowProcessingIndicator="@Palette2ShowProcessing"
                QueueLength="@Palette2QueueLength"
                OnReset="@(() => OnPalette2Reset.InvokeAsync())"
                OnToggleMode="@(() => OnPalette2ToggleMode.InvokeAsync())"
                OnWorkpieceClick="OnWorkpieceClick" />

            <PaletteCard
                PaletteId="1"
                Title="Palette 1"
                Workpieces="@Palette1Workpieces"
                Mode="@Palette1Mode"
                IsInProgress="@Palette1InProgress"
                ProgressStep="@Palette1ProgressStep"
                ShowProcessingIndicator="@Palette1ShowProcessing"
                QueueLength="@Palette1QueueLength"
                OnReset="@(() => OnPalette1Reset.InvokeAsync())"
                OnToggleMode="@(() => OnPalette1ToggleMode.InvokeAsync())"
                OnWorkpieceClick="OnWorkpieceClick" />
            </div>
        }
        else
        {
            <!-- Shelf View - 7x4 Grid -->
            <div class="shelf-container">
                <ShelfCard
                    Workpieces="@ShelfWorkpieces"
                    Mode="@ShelfMode"
                    IsInProgress="@ShelfInProgress"
                    ProgressStep="@ShelfProgressStep"
                    ShowProcessingIndicator="@ShelfShowProcessing"
                    OnReset="@(() => OnShelfReset.InvokeAsync())"
                    OnToggleMode="@(() => OnShelfToggleMode.InvokeAsync())"
                    OnWorkpieceClick="OnWorkpieceClick" />
            </div>
        }
    </div>
</div>

@code {
    // View Mode
    private ViewMode CurrentView { get; set; } = ViewMode.Palette;

    // Palette 1
    [Parameter] public List<WorkpieceStatus> Palette1Workpieces { get; set; } = new();
    [Parameter] public PaletteMode Palette1Mode { get; set; } = PaletteMode.Active;
    [Parameter] public bool Palette1InProgress { get; set; }
    [Parameter] public int Palette1ProgressStep { get; set; }
    [Parameter] public bool Palette1ShowProcessing { get; set; }
    [Parameter] public int Palette1QueueLength { get; set; }

    // Palette 2
    [Parameter] public List<WorkpieceStatus> Palette2Workpieces { get; set; } = new();
    [Parameter] public PaletteMode Palette2Mode { get; set; } = PaletteMode.Active;
    [Parameter] public bool Palette2InProgress { get; set; }
    [Parameter] public int Palette2ProgressStep { get; set; }
    [Parameter] public bool Palette2ShowProcessing { get; set; }
    [Parameter] public int Palette2QueueLength { get; set; }

    // Shelf (7x4 = 28 positions)
    [Parameter] public List<WorkpieceStatus> ShelfWorkpieces { get; set; } = new();
    [Parameter] public ShelfMode ShelfMode { get; set; } = ShelfMode.Active;
    [Parameter] public bool ShelfInProgress { get; set; }
    [Parameter] public int ShelfProgressStep { get; set; }
    [Parameter] public bool ShelfShowProcessing { get; set; }

    // Events - Palettes
    [Parameter] public EventCallback OnPalette1Reset { get; set; }
    [Parameter] public EventCallback OnPalette1ToggleMode { get; set; }
    [Parameter] public EventCallback OnPalette2Reset { get; set; }
    [Parameter] public EventCallback OnPalette2ToggleMode { get; set; }

    // Events - Shelf
    [Parameter] public EventCallback OnShelfReset { get; set; }
    [Parameter] public EventCallback OnShelfToggleMode { get; set; }

    // Shared Events
    [Parameter] public EventCallback<WorkpieceStatus> OnWorkpieceClick { get; set; }

    private void SetView(ViewMode mode)
    {
        CurrentView = mode;
    }

    public enum ViewMode
    {
        Palette,
        Shelf
    }
}

@inject IUserService UserService
@inject INfcService NfcService
@inject ITranslationService T
@inject IAuthorizationService Authorization
@implements IDisposable

<div class="bg-white/40 backdrop-blur-sm rounded-xl p-6 shadow-lg">
    <div class="flex items-center justify-between mb-4">
        <div class="flex items-center space-x-2">
            <Blazicon Svg="Lucide.Users" class="w-5 h-5 text-primary" />
            <h3 class="font-semibold text-lg">@T.Translate("users.title")</h3>
        </div>
        @if (Authorization.IsAdmin())
        {
            <button class="px-4 py-2 bg-primary text-white rounded-lg robot-control-btn flex items-center space-x-2"
                    @onclick="ShowCreateDialog">
                <Blazicon Svg="Lucide.UserPlus" class="w-4 h-4" />
                <span>@T.Translate("users.add")</span>
            </button>
        }
    </div>

    <!-- Users Table -->
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead>
                <tr class="border-b border-gray-200">
                    <th class="text-left py-3 px-4 font-semibold text-gray-700">@T.Translate("users.personalNumber")</th>
                    <th class="text-left py-3 px-4 font-semibold text-gray-700">@T.Translate("users.name")</th>
                    <th class="text-left py-3 px-4 font-semibold text-gray-700">@T.Translate("users.role")</th>
                    <th class="text-left py-3 px-4 font-semibold text-gray-700">@T.Translate("users.status")</th>
                    <th class="text-left py-3 px-4 font-semibold text-gray-700">@T.Translate("users.rfid")</th>
                    <th class="text-right py-3 px-4 font-semibold text-gray-700">@T.Translate("users.actions")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in _users)
                {
                    <tr class="border-b border-gray-100 hover:bg-white/30">
                        <td class="py-3 px-4">@user.PersonalNumber</td>
                        <td class="py-3 px-4">@(user.Name ?? "-")</td>
                        <td class="py-3 px-4">
                            <span class="px-2 py-1 rounded-full text-xs font-semibold @GetRoleBadgeClass(user.Role)">
                                @GetRoleDisplayName(user.Role)
                            </span>
                        </td>
                        <td class="py-3 px-4">
                            <span class="px-2 py-1 rounded-full text-xs font-semibold @(user.IsActive ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-700")">
                                @(user.IsActive ? T.Translate("users.active") : T.Translate("users.inactive"))
                            </span>
                        </td>
                        <td class="py-3 px-4">
                            @if (!string.IsNullOrEmpty(user.RfidTag))
                            {
                                <span class="text-green-600">
                                    <Blazicon Svg="Lucide.CreditCard" class="w-4 h-4 inline" />
                                </span>
                            }
                            else
                            {
                                <span class="text-gray-400">-</span>
                            }
                        </td>
                        <td class="py-3 px-4 text-right">
                            @if (Authorization.IsAdmin())
                            {
                                <button class="p-2 text-primary hover:bg-blue-100 rounded-lg mr-1"
                                        @onclick="() => ShowEditDialog(user)">
                                    <Blazicon Svg="Lucide.Pencil" class="w-4 h-4" />
                                </button>
                                <button class="p-2 text-red-600 hover:bg-red-100 rounded-lg"
                                        @onclick="() => ShowDeleteDialog(user)">
                                    <Blazicon Svg="Lucide.Trash2" class="w-4 h-4" />
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create/Edit Dialog -->
@if (_showDialog)
{
    <div class="dialog-overlay" @onclick="CloseDialog">
        <div class="bg-white rounded-xl p-6 w-full max-w-md shadow-xl" @onclick:stopPropagation>
            <h3 class="text-lg font-semibold mb-4">
                @(_editingUser == null ? T.Translate("users.createTitle") : T.Translate("users.editTitle"))
            </h3>

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">@T.Translate("users.personalNumber") *</label>
                    <input type="text"
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                           @bind="_formPersonalNumber" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">@T.Translate("users.name")</label>
                    <input type="text"
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                           @bind="_formName" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        @T.Translate("users.password") @(_editingUser == null ? "*" : T.Translate("users.passwordHint"))
                    </label>
                    <input type="password"
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                           @bind="_formPassword" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">@T.Translate("users.role") *</label>
                    <select class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                            @bind="_formRole">
                        <option value="@UserRole.Bediener">@T.Translate("users.role.bediener")</option>
                        <option value="@UserRole.Einrichter">@T.Translate("users.role.einrichter")</option>
                        <option value="@UserRole.Admin">@T.Translate("users.role.admin")</option>
                    </select>
                </div>

                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-gray-700">@T.Translate("users.isActive")</span>
                    <button class="w-12 h-6 rounded-full transition-colors duration-200 @(_formIsActive ? "bg-primary" : "bg-gray-300")"
                            @onclick="() => _formIsActive = !_formIsActive">
                        <div class="w-5 h-5 bg-white rounded-full shadow transform transition-transform duration-200 @(_formIsActive ? "translate-x-6" : "translate-x-0.5")"></div>
                    </button>
                </div>

                <!-- RFID Section -->
                <div class="border-t border-gray-200 pt-4">
                    <label class="block text-sm font-medium text-gray-700 mb-2">@T.Translate("users.rfidTag")</label>
                    @if (!string.IsNullOrEmpty(_formRfidTag))
                    {
                        <div class="flex items-center justify-between p-3 bg-green-50 rounded-lg">
                            <div class="flex items-center space-x-2">
                                <Blazicon Svg="Lucide.CreditCard" class="w-5 h-5 text-green-600" />
                                <span class="text-green-700">
                                    @(_formRfidTag == "[assigned]" ? T.Translate("users.rfidAssigned") : T.Translate("users.rfidNew"))
                                </span>
                            </div>
                            <button class="p-1 text-red-600 hover:bg-red-100 rounded"
                                    @onclick="RemoveRfid">
                                <Blazicon Svg="Lucide.X" class="w-4 h-4" />
                            </button>
                        </div>
                    }
                    else
                    {
                        @if (_isScanning)
                        {
                            <div class="flex items-center justify-center p-4 bg-blue-50 rounded-lg">
                                <div class="w-3 h-3 bg-primary rounded-full animate-pulse mr-3"></div>
                                <span class="text-primary">@T.Translate("users.scanningNfc")</span>
                            </div>
                        }
                        else
                        {
                            <button class="w-full px-4 py-2 border-2 border-dashed border-gray-300 rounded-lg text-gray-600 hover:border-primary hover:text-primary flex items-center justify-center space-x-2"
                                    @onclick="StartNfcScan"
                                    disabled="@(!NfcService.IsReaderConnected)">
                                <Blazicon Svg="Lucide.Scan" class="w-5 h-5" />
                                <span>@T.Translate("users.scanNfc")</span>
                            </button>
                        }
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_dialogError))
            {
                <div class="mt-4 p-3 bg-red-100 border border-red-300 rounded-lg text-red-700 text-sm">
                    @_dialogError
                </div>
            }

            <div class="flex justify-end space-x-3 mt-6">
                <button class="px-4 py-2 bg-gray-200 rounded-lg"
                        @onclick="CloseDialog">
                    @T.Translate("common.cancel")
                </button>
                <button class="px-4 py-2 bg-primary text-white rounded-lg"
                        @onclick="SaveUser"
                        disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <span class="flex items-center">
                            <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            @T.Translate("common.saving")
                        </span>
                    }
                    else
                    {
                        @T.Translate("common.save")
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Dialog -->
@if (_showDeleteDialog && _deletingUser != null)
{
    <div class="dialog-overlay" @onclick="CloseDeleteDialog">
        <div class="bg-white rounded-xl p-6 w-full max-w-sm shadow-xl" @onclick:stopPropagation>
            <div class="text-center mb-4">
                <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-3">
                    <Blazicon Svg="Lucide.TriangleAlert" class="w-6 h-6 text-red-600" />
                </div>
                <h3 class="text-lg font-semibold">@T.Translate("users.deleteTitle")</h3>
                <p class="text-gray-600 mt-2">
                    @T.Translate("users.deleteConfirm", _deletingUser.PersonalNumber)
                </p>
            </div>

            <div class="flex justify-center space-x-3">
                <button class="px-4 py-2 bg-gray-200 rounded-lg"
                        @onclick="CloseDeleteDialog">
                    @T.Translate("common.cancel")
                </button>
                <button class="px-4 py-2 bg-red-600 text-white rounded-lg"
                        @onclick="DeleteUser">
                    @T.Translate("users.delete")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<User> _users = new();
    private bool _showDialog;
    private bool _showDeleteDialog;
    private User? _editingUser;
    private User? _deletingUser;

    // Form fields
    private string _formPersonalNumber = "";
    private string _formName = "";
    private string _formPassword = "";
    private UserRole _formRole = UserRole.Bediener;
    private bool _formIsActive = true;
    private string? _formRfidTag;
    private string? _dialogError;
    private bool _isSaving;
    private bool _isScanning;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
        NfcService.OnCardDetected += OnNfcCardDetected;
        T.LanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task LoadUsers()
    {
        _users = (await UserService.GetAllUsersAsync()).ToList();
    }

    private void ShowCreateDialog()
    {
        _editingUser = null;
        _formPersonalNumber = "";
        _formName = "";
        _formPassword = "";
        _formRole = UserRole.Bediener;
        _formIsActive = true;
        _formRfidTag = null;
        _dialogError = null;
        _showDialog = true;
    }

    private void ShowEditDialog(User user)
    {
        _editingUser = user;
        _formPersonalNumber = user.PersonalNumber;
        _formName = user.Name ?? "";
        _formPassword = "";
        _formRole = user.Role;
        _formIsActive = user.IsActive;
        _formRfidTag = !string.IsNullOrEmpty(user.RfidTag) ? "[assigned]" : null;
        _dialogError = null;
        _showDialog = true;
    }

    private void CloseDialog()
    {
        _showDialog = false;
        _isScanning = false;
        NfcService.StopListening();
    }

    private async Task SaveUser()
    {
        _dialogError = null;

        if (string.IsNullOrWhiteSpace(_formPersonalNumber))
        {
            _dialogError = T.Translate("users.error.personalNumberRequired");
            return;
        }

        if (_editingUser == null && string.IsNullOrWhiteSpace(_formPassword))
        {
            _dialogError = T.Translate("users.error.passwordRequired");
            return;
        }

        _isSaving = true;

        try
        {
            if (_editingUser == null)
            {
                // Create new user
                var rfidTag = _formRfidTag != "[assigned]" ? _formRfidTag : null;
                await UserService.CreateUserAsync(_formPersonalNumber, _formPassword, _formRole, _formName, rfidTag);
            }
            else
            {
                // Update existing user
                string? rfidTag = null;
                if (_formRfidTag == null)
                {
                    // RFID removed
                    rfidTag = "";
                }
                else if (_formRfidTag != "[assigned]")
                {
                    // New RFID assigned
                    rfidTag = _formRfidTag;
                }
                // else: unchanged (don't pass anything)

                await UserService.UpdateUserAsync(
                    _editingUser.Id,
                    _formPersonalNumber != _editingUser.PersonalNumber ? _formPersonalNumber : null,
                    !string.IsNullOrWhiteSpace(_formPassword) ? _formPassword : null,
                    _formRole != _editingUser.Role ? _formRole : null,
                    _formName != _editingUser.Name ? _formName : null,
                    rfidTag,
                    _formIsActive != _editingUser.IsActive ? _formIsActive : null);
            }

            await LoadUsers();
            CloseDialog();
        }
        catch (Exception ex)
        {
            _dialogError = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ShowDeleteDialog(User user)
    {
        _deletingUser = user;
        _showDeleteDialog = true;
    }

    private void CloseDeleteDialog()
    {
        _showDeleteDialog = false;
        _deletingUser = null;
    }

    private async Task DeleteUser()
    {
        if (_deletingUser == null)
            return;

        await UserService.DeleteUserAsync(_deletingUser.Id);
        await LoadUsers();
        CloseDeleteDialog();
    }

    private void StartNfcScan()
    {
        _isScanning = true;
        NfcService.StartListening();
    }

    private void OnNfcCardDetected(object? sender, string rfidUid)
    {
        if (!_isScanning)
            return;

        InvokeAsync(() =>
        {
            _formRfidTag = rfidUid;
            _isScanning = false;
            NfcService.StopListening();
            StateHasChanged();
        });
    }

    private void RemoveRfid()
    {
        _formRfidTag = null;
    }

    private string GetRoleBadgeClass(UserRole role) => role switch
    {
        UserRole.Admin => "bg-purple-100 text-purple-700",
        UserRole.Einrichter => "bg-blue-100 text-blue-700",
        UserRole.Bediener => "bg-green-100 text-green-700",
        _ => "bg-gray-100 text-gray-700"
    };

    private string GetRoleDisplayName(UserRole role) => role switch
    {
        UserRole.Admin => T.Translate("users.role.admin"),
        UserRole.Einrichter => T.Translate("users.role.einrichter"),
        UserRole.Bediener => T.Translate("users.role.bediener"),
        _ => role.ToString()
    };

    public void Dispose()
    {
        NfcService.OnCardDetected -= OnNfcCardDetected;
        T.LanguageChanged -= OnLanguageChanged;
    }
}

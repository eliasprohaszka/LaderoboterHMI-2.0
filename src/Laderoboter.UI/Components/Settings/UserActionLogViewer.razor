@inject IUserActionLogService ActionLogService
@inject ITranslationService T
@implements IDisposable

<div class="bg-white/40 backdrop-blur-sm rounded-xl p-6 shadow-lg">
    <div class="flex items-center justify-between mb-4">
        <div class="flex items-center space-x-2">
            <Blazicon Svg="Lucide.History" class="w-5 h-5 text-primary" />
            <h3 class="font-semibold text-lg">@T.Translate("actionLog.title")</h3>
        </div>
        <div class="flex items-center space-x-2">
            <input type="date"
                   class="px-3 py-1 border border-gray-300 rounded-lg text-sm"
                   @bind="_fromDate" />
            <span class="text-gray-500">-</span>
            <input type="date"
                   class="px-3 py-1 border border-gray-300 rounded-lg text-sm"
                   @bind="_toDate" />
            <button class="px-3 py-1 bg-primary text-white rounded-lg text-sm"
                    @onclick="LoadLogs">
                <Blazicon Svg="Lucide.Search" class="w-4 h-4" />
            </button>
        </div>
    </div>

    <div class="overflow-x-auto max-h-96 overflow-y-auto">
        <table class="w-full">
            <thead class="sticky top-0 bg-white/80 backdrop-blur-sm">
                <tr class="border-b border-gray-200">
                    <th class="text-left py-2 px-3 font-semibold text-gray-700 text-sm">@T.Translate("actionLog.timestamp")</th>
                    <th class="text-left py-2 px-3 font-semibold text-gray-700 text-sm">@T.Translate("actionLog.user")</th>
                    <th class="text-left py-2 px-3 font-semibold text-gray-700 text-sm">@T.Translate("actionLog.action")</th>
                    <th class="text-left py-2 px-3 font-semibold text-gray-700 text-sm">@T.Translate("actionLog.details")</th>
                </tr>
            </thead>
            <tbody>
                @if (_logs.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="py-8 text-center text-gray-500">
                            @T.Translate("actionLog.noEntries")
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var log in _logs)
                    {
                        <tr class="border-b border-gray-100 hover:bg-white/30">
                            <td class="py-2 px-3 text-sm text-gray-600">
                                @log.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")
                            </td>
                            <td class="py-2 px-3 text-sm">
                                @(log.PersonalNumber ?? log.User?.PersonalNumber ?? "-")
                            </td>
                            <td class="py-2 px-3 text-sm">
                                <span class="px-2 py-0.5 rounded-full text-xs font-semibold @GetActionBadgeClass(log.Action)">
                                    @log.Action
                                </span>
                            </td>
                            <td class="py-2 px-3 text-sm text-gray-600 max-w-xs truncate" title="@log.Details">
                                @(log.Details ?? "-")
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (_logs.Count > 0)
    {
        <div class="mt-4 text-sm text-gray-500 text-right">
            @T.Translate("actionLog.entriesCount", _logs.Count)
        </div>
    }
</div>

@code {
    private List<UserActionLog> _logs = new();
    private DateTime? _fromDate;
    private DateTime? _toDate;

    protected override async Task OnInitializedAsync()
    {
        _fromDate = DateTime.Today.AddDays(-7);
        _toDate = DateTime.Today;
        await LoadLogs();
        T.LanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task LoadLogs()
    {
        var from = _fromDate?.Date;
        var to = _toDate?.Date.AddDays(1).AddSeconds(-1); // End of day

        _logs = (await ActionLogService.GetLogsAsync(null, from, to)).ToList();
    }

    private string GetActionBadgeClass(string action) => action switch
    {
        "Login" => "bg-green-100 text-green-700",
        "Logout" => "bg-gray-100 text-gray-700",
        "Benutzer angelegt" => "bg-blue-100 text-blue-700",
        "Benutzer bearbeitet" => "bg-yellow-100 text-yellow-700",
        "Benutzer gelöscht" => "bg-red-100 text-red-700",
        _ => "bg-gray-100 text-gray-700"
    };

    public void Dispose()
    {
        T.LanguageChanged -= OnLanguageChanged;
    }
}

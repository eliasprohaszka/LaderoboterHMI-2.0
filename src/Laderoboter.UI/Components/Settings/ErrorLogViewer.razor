@inject IErrorLogService ErrorLogService

<div class="error-log-viewer">
    <div class="viewer-header">
        <h3>📋 Fehlerprotokoll</h3>
        <div class="header-actions">
            <button class="btn btn-secondary btn-sm" @onclick="Refresh">🔄 Aktualisieren</button>
            <button class="btn btn-danger btn-sm" @onclick="ShowClearConfirm">🗑️ Alle löschen</button>
        </div>
    </div>

    <div class="viewer-body">
        @if (isLoading)
        {
            <div class="loading">Lade...</div>
        }
        else if (!errorLogs.Any())
        {
            <div class="empty-state">
                <span class="empty-icon">✓</span>
                <p>Keine Fehler vorhanden</p>
            </div>
        }
        else
        {
            <div class="log-table-container">
                <table class="log-table">
                    <thead>
                        <tr>
                            <th>Zeit</th>
                            <th>Schweregrad</th>
                            <th>Quelle</th>
                            <th>Nachricht</th>
                            <th>Aktionen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in errorLogs)
                        {
                            <tr class="@GetSeverityClass(log.Severity)">
                                <td class="col-time">@log.Timestamp.ToLocalTime().ToString("dd.MM.yy HH:mm:ss")</td>
                                <td class="col-severity">
                                    <span class="severity-badge @GetSeverityClass(log.Severity)">
                                        @GetSeverityText(log.Severity)
                                    </span>
                                </td>
                                <td class="col-source">@log.Source</td>
                                <td class="col-message">@log.ErrorMessage</td>
                                <td class="col-actions">
                                    @if (!log.AcknowledgedAt.HasValue)
                                    {
                                        <button class="btn-icon" title="Bestätigen" @onclick="() => Acknowledge(log.Id)">✓</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="pagination">
                <button class="btn btn-secondary btn-sm" disabled="@(currentPage <= 1)" @onclick="PreviousPage">
                    ← Zurück
                </button>
                <span class="page-info">Seite @currentPage von @totalPages</span>
                <button class="btn btn-secondary btn-sm" disabled="@(currentPage >= totalPages)" @onclick="NextPage">
                    Weiter →
                </button>
            </div>
        }
    </div>
</div>

<ConfirmationDialog IsVisible="@showClearConfirm"
                   Title="Fehlerprotokoll löschen"
                   Message="Möchten Sie wirklich alle Fehlerprotokolle löschen? Diese Aktion kann nicht rückgängig gemacht werden."
                   ConfirmText="Alle löschen"
                   IsDangerous="true"
                   OnConfirmed="ClearAll"
                   OnCancelled="() => showClearConfirm = false" />

@code {
    private List<ErrorLog> errorLogs = new();
    private bool isLoading = true;
    private int currentPage = 1;
    private int pageSize = 20;
    private int totalPages = 1;
    private bool showClearConfirm = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadLogs();
    }

    private async Task LoadLogs()
    {
        isLoading = true;
        var totalCount = await ErrorLogService.GetTotalCountAsync();
        totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
        errorLogs = (await ErrorLogService.GetAllAsync(currentPage, pageSize)).ToList();
        isLoading = false;
    }

    private async Task Refresh()
    {
        await LoadLogs();
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadLogs();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadLogs();
        }
    }

    private async Task Acknowledge(int id)
    {
        await ErrorLogService.AcknowledgeAsync(id);
        await LoadLogs();
    }

    private void ShowClearConfirm()
    {
        showClearConfirm = true;
    }

    private async Task ClearAll()
    {
        await ErrorLogService.ClearAllAsync();
        showClearConfirm = false;
        currentPage = 1;
        await LoadLogs();
    }

    private string GetSeverityClass(ErrorSeverity severity) => severity switch
    {
        ErrorSeverity.Info => "info",
        ErrorSeverity.Warning => "warning",
        ErrorSeverity.Error => "error",
        ErrorSeverity.Critical => "critical",
        _ => ""
    };

    private string GetSeverityText(ErrorSeverity severity) => severity switch
    {
        ErrorSeverity.Info => "Info",
        ErrorSeverity.Warning => "Warnung",
        ErrorSeverity.Error => "Fehler",
        ErrorSeverity.Critical => "Kritisch",
        _ => "Unbekannt"
    };
}

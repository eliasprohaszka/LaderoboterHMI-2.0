@page "/settings"
@inject ISettingsService Settings
@inject IRobotService RobotService
@inject ITranslationService T
@inject NavigationManager Navigation
@implements IDisposable

<div class="h-full">
    <!-- Settings Section (exact match to settings.vue) -->
    <div class="border-0 bg-white/20 backdrop-blur-md rounded-lg shadow-lg overflow-hidden w-full h-full flex flex-col">
        <!-- Header -->
        <div class="px-6 py-4">
            <div class="flex items-center justify-between w-full">
                <div class="flex items-center space-x-3">
                    <div class="p-2 bg-blue-100 rounded-lg">
                        <Blazicon Svg="Lucide.Settings" class="w-5 h-5 text-primary" />
                    </div>
                    <div class="text-left">
                        <span class="font-semibold text-lg">@T.Translate("settings.title")</span>
                        <p class="text-sm text-gray-600 mt-1">@T.Translate("settings.description")</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <button
                        class="p-2 rounded-lg text-white transition-all duration-200 robot-control-btn shadow-lg bg-primary flex items-center justify-center"
                        title="@T.Translate("common.save")"
                        @onclick="SaveAllSettings">
                        <Blazicon Svg="Lucide.Save" class="w-5 h-5" />
                    </button>
                    <button
                        class="p-2 rounded-lg text-white transition-all duration-200 robot-control-btn shadow-lg bg-gray-600 flex items-center justify-center"
                        title="@T.Translate("common.reset")"
                        @onclick="ResetAllSettings">
                        <Blazicon Svg="Lucide.RotateCcw" class="w-5 h-5" />
                    </button>
                    <ActionDropdown @ref="actionsDropdown">
                        <button class="dropdown-item" @onclick="ExportAndClose">
                            <Blazicon Svg="Lucide.Download" class="dropdown-item-icon" />
                            <span>@T.Translate("settings.export")</span>
                        </button>
                        <button class="dropdown-item" @onclick="ImportAndClose">
                            <Blazicon Svg="Lucide.Upload" class="dropdown-item-icon" />
                            <span>@T.Translate("settings.import")</span>
                        </button>
                        <div class="dropdown-divider"></div>
                        <button class="dropdown-item" @onclick="NavigateToTranslationsAndClose">
                            <Blazicon Svg="Lucide.Globe" class="dropdown-item-icon" />
                            <span>@T.Translate("settings.language.manageTranslations")</span>
                        </button>
                        <button class="dropdown-item" @onclick="NavigateToUsersAndClose">
                            <Blazicon Svg="Lucide.Users" class="dropdown-item-icon" />
                            <span>@T.Translate("users.title")</span>
                        </button>
                        <button class="dropdown-item" @onclick="NavigateToActionLogAndClose">
                            <Blazicon Svg="Lucide.ScrollText" class="dropdown-item-icon" />
                            <span>@T.Translate("actionLog.title")</span>
                        </button>
                    </ActionDropdown>
                </div>
            </div>
        </div>

        <!-- Content -->
        <div class="px-6 pb-6 flex-1 overflow-auto">
            <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
                <!-- Robot Settings + Connection Status Card (Left, wider) -->
                <div class="bg-white/40 backdrop-blur-sm rounded-xl p-6 shadow-lg md:col-span-3">
                    <div class="flex items-center space-x-2 mb-4">
                        <Blazicon Svg="Lucide.Bot" class="w-5 h-5 text-primary" />
                        <h3 class="font-semibold text-lg">@T.Translate("settings.robot.title")</h3>
                    </div>

                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">@T.Translate("settings.robot.ipAddress")</label>
                            <input type="text"
                                   class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                                   @bind="robotIp" placeholder="192.168.1.100" />
                        </div>

                        <div class="flex items-center justify-between">
                            <span class="text-sm font-medium text-gray-700">@T.Translate("settings.robot.offlineMode")</span>
                            <button
                                class="w-12 h-6 rounded-full transition-colors duration-200 @(offlineMode ? "bg-primary" : "bg-gray-300")"
                                @onclick="() => offlineMode = !offlineMode">
                                <div class="w-5 h-5 bg-white rounded-full shadow transform transition-transform duration-200 @(offlineMode ? "translate-x-6" : "translate-x-0.5")"></div>
                            </button>
                        </div>

                        @if (offlineMode)
                        {
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">@T.Translate("settings.robot.roboGuidePath")</label>
                                <input type="text"
                                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                                       @bind="roboGuidePath" placeholder="C:\Path\To\Workcell" />
                            </div>
                        }

                        <div class="flex items-center justify-between">
                            <span class="text-sm font-medium text-gray-700">@T.Translate("settings.robot.autoConnect")</span>
                            <button
                                class="w-12 h-6 rounded-full transition-colors duration-200 @(autoConnect ? "bg-primary" : "bg-gray-300")"
                                @onclick="() => autoConnect = !autoConnect">
                                <div class="w-5 h-5 bg-white rounded-full shadow transform transition-transform duration-200 @(autoConnect ? "translate-x-6" : "translate-x-0.5")"></div>
                            </button>
                        </div>

                        <!-- Connection Status integrated -->
                        <div class="pt-4 border-t border-gray-200">
                            <div class="flex items-center justify-between p-3 bg-gray-100 rounded-lg mb-3">
                                <span class="font-medium">@T.Translate("settings.connection.status")</span>
                                <div class="flex items-center space-x-2">
                                    <div class="w-3 h-3 rounded-full @(RobotService.IsConnected ? "bg-green-500" : "bg-gray-400")"></div>
                                    <span class="@(RobotService.IsConnected ? "text-green-600" : "text-gray-600")">
                                        @(RobotService.IsConnected ? T.Translate("common.connected") : T.Translate("common.disconnected"))
                                    </span>
                                </div>
                            </div>

                            <button
                                class="w-full px-4 py-3 rounded-lg robot-control-btn flex items-center justify-center space-x-2 @(RobotService.IsConnected ? "bg-red-600" : "bg-green-600") text-white"
                                @onclick="ToggleConnection">
                                <Blazicon Svg="@(RobotService.IsConnected ? Lucide.WifiOff : Lucide.Wifi)" class="w-5 h-5" />
                                <span>@(RobotService.IsConnected ? T.Translate("connection.disconnect") : T.Translate("connection.connect"))</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Language & Display Card (Right, narrower) -->
                <div class="bg-white/40 backdrop-blur-sm rounded-xl p-6 shadow-lg md:col-span-2">
                    <div class="flex items-center space-x-2 mb-4">
                        <Blazicon Svg="Lucide.Globe" class="w-5 h-5 text-primary" />
                        <h3 class="font-semibold text-lg">@T.Translate("settings.language.title")</h3>
                    </div>

                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">@T.Translate("settings.language.language")</label>
                            <select
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                                @bind="selectedLanguage">
                                @foreach (var lang in availableLanguages)
                                {
                                    <option value="@lang.Code">@lang.NativeName</option>
                                }
                            </select>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // Components
    private ActionDropdown? actionsDropdown;

    // Robot settings
    private string robotIp = "192.168.1.1";
    private string roboGuidePath = "";
    private bool offlineMode = false;
    private bool autoConnect = false;

    // UI settings
    private string selectedLanguage = "de";
    private IEnumerable<Laderoboter.Core.Models.Language> availableLanguages = new List<Laderoboter.Core.Models.Language>();

    protected override async Task OnInitializedAsync()
    {
        // Load settings (use same keys as MainPage)
        robotIp = await Settings.GetAsync("robot.connection.ip") ?? "192.168.1.1";
        roboGuidePath = await Settings.GetAsync("robot.roboguide_path") ?? "";
        offlineMode = await Settings.GetAsync<bool>("robot.offline");
        autoConnect = await Settings.GetAsync<bool>("robot.connection.autoConnect");
        selectedLanguage = T.CurrentLanguage;

        // Load available languages
        availableLanguages = await T.GetActiveLanguagesAsync();

        T.LanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task SaveAllSettings()
    {
        // Save robot settings
        await Settings.SetAsync("robot.connection.ip", robotIp);
        await Settings.SetAsync("robot.roboguide_path", roboGuidePath);
        await Settings.SetAsync("robot.offline", offlineMode);
        await Settings.SetAsync("robot.connection.autoConnect", autoConnect);

        // Save UI settings
        await T.SetLanguageAsync(selectedLanguage);
    }

    private async Task ResetAllSettings()
    {
        // Reset to saved values
        robotIp = await Settings.GetAsync("robot.connection.ip") ?? "192.168.1.1";
        roboGuidePath = await Settings.GetAsync("robot.roboguide_path") ?? "";
        offlineMode = await Settings.GetAsync<bool>("robot.offline");
        autoConnect = await Settings.GetAsync<bool>("robot.connection.autoConnect");
        selectedLanguage = T.CurrentLanguage;
    }

    private async Task ToggleConnection()
    {
        if (RobotService.IsConnected)
        {
            await RobotService.DisconnectAsync();
        }
        else
        {
            var connectionString = offlineMode ? roboGuidePath : robotIp;
            await RobotService.ConnectAsync(connectionString);
        }
    }

    private void ExportSettings()
    {
        // TODO: Implement export
    }

    private void ImportSettings()
    {
        // TODO: Implement import
    }

    private async Task SaveAndClose()
    {
        await SaveAllSettings();
        actionsDropdown?.Close();
    }

    private async Task ResetAndClose()
    {
        await ResetAllSettings();
        actionsDropdown?.Close();
    }

    private void ExportAndClose()
    {
        ExportSettings();
        actionsDropdown?.Close();
    }

    private void ImportAndClose()
    {
        ImportSettings();
        actionsDropdown?.Close();
    }

    private void NavigateToTranslations()
    {
        Navigation.NavigateTo("/translations");
    }

    private void NavigateToUsers()
    {
        Navigation.NavigateTo("/users");
    }

    private void NavigateToActionLog()
    {
        Navigation.NavigateTo("/actionlog");
    }

    private void NavigateToTranslationsAndClose()
    {
        actionsDropdown?.Close();
        NavigateToTranslations();
    }

    private void NavigateToUsersAndClose()
    {
        actionsDropdown?.Close();
        NavigateToUsers();
    }

    private void NavigateToActionLogAndClose()
    {
        actionsDropdown?.Close();
        NavigateToActionLog();
    }

    public void Dispose()
    {
        T.LanguageChanged -= OnLanguageChanged;
    }
}
@page "/maintenance"
@using Laderoboter.Core.Models
@using Laderoboter.Core.Services
@inject IRobotService RobotService
@inject IRegisterErrorService RegisterErrorService
@inject ISystemService SystemService
@inject ITranslationService T
@inject IAuthorizationService Authorization
@inject NavigationManager Navigation
@implements IDisposable

@if (!Authorization.CanAccessMaintenance())
{
    <div class="h-full flex items-center justify-center">
        <div class="bg-red-100 border border-red-300 rounded-xl p-8 text-center">
            <Blazicon Svg="Lucide.ShieldX" class="w-16 h-16 text-red-500 mx-auto mb-4" />
            <h2 class="text-xl font-bold text-red-700">@T.Translate("common.error")</h2>
            <p class="text-red-600 mt-2">@T.Translate("users.noAccess")</p>
        </div>
    </div>
}
else
{
<div class="h-full pt-4">
    <!-- Maintenance Section - Touch Optimized with Glassmorphism -->
    <div class="glass-card w-full h-full flex flex-col overflow-hidden">
        <!-- Header -->
        <div class="maintenance-header">
            <div class="header-content">
                <button
                    class="p-2 transition-colors"
                    @onclick="NavigateBack">
                    <Blazicon Svg="Lucide.ArrowLeft" class="w-5 h-5 text-gray-600" />
                </button>
                <div class="header-icon-wrapper">
                    <Blazicon Svg="Lucide.Wrench" class="header-icon" />
                </div>
                <div class="header-text">
                    <h2 class="header-title">@T.Translate("maintenance.title")</h2>
                    <p class="header-description">@T.Translate("maintenance.description")</p>
                </div>
            </div>
        </div>

        <!-- Content -->
        <div class="maintenance-content">
            <MaintenanceGrid>
                <!-- Zeile 1: Werkstück ablegen + abholen -->
                <MaintenanceSplitTile
                    FullWidth="true"
                    IconLeft="Lucide.ArrowBigDownDash"
                    LabelLeft="@T.Translate("maintenance.layDown")"
                    DisabledLeft="@(!RobotService.IsConnected)"
                    OnClickLeft="ShowLayDownConfirmation"
                    IconRight="Lucide.ArrowBigUpDash"
                    LabelRight="@T.Translate("maintenance.pickUp")"
                    DisabledRight="@(!RobotService.IsConnected)"
                    OnClickRight="ShowPickUpConfirmation" />

                <!-- Zeile 2: Home + Wartungstür -->
                <MaintenanceSplitTile
                    FullWidth="true"
                    IconLeft="Lucide.House"
                    LabelLeft="@T.Translate("maintenance.homePosition")"
                    DisabledLeft="@(!RobotService.IsConnected)"
                    OnClickLeft="ShowHomeConfirmation"
                    IconRight="Lucide.DoorOpen"
                    LabelRight="@T.Translate("maintenance.maintenanceDoor")"
                    SublabelRight="@T.Translate("maintenance.release")"
                    DisabledRight="@(!RobotService.IsConnected)"
                    OnClickRight="ToggleMaintenanceDoor" />

                <!-- Zeile 3: Ladetür (öffnen/schließen) -->
                <MaintenanceSplitTile
                    IconLeft="Lucide.DoorOpen"
                    LabelLeft="@T.Translate("maintenance.loadDoor")"
                    SublabelLeft="@T.Translate("maintenance.open")"
                    DisabledLeft="@(!RobotService.IsConnected)"
                    OnClickLeft="OpenLoadDoor"
                    IconRight="Lucide.DoorClosed"
                    LabelRight="@T.Translate("maintenance.loadDoor")"
                    SublabelRight="@T.Translate("maintenance.close")"
                    DisabledRight="@(!RobotService.IsConnected)"
                    OnClickRight="CloseLoadDoor" />

                <!-- Zeile 3: Palettentür 1 + 2 -->
                <MaintenanceSplitTile
                    IconLeft="Lucide.DoorOpen"
                    LabelLeft="@T.Translate("maintenance.paletteDoor1")"
                    SublabelLeft="@T.Translate("maintenance.release")"
                    DisabledLeft="@(!RobotService.IsConnected)"
                    OnClickLeft="() => TogglePaletteDoor(1)"
                    IconRight="Lucide.DoorOpen"
                    LabelRight="@T.Translate("maintenance.paletteDoor2")"
                    SublabelRight="@T.Translate("maintenance.release")"
                    DisabledRight="@(!RobotService.IsConnected)"
                    OnClickRight="() => TogglePaletteDoor(2)" />

                <!-- Zeile 4: I/O Signale + Fehler -->
                <MaintenanceSplitTile
                    IconLeft="Lucide.Activity"
                    LabelLeft="@T.Translate("maintenance.ioSignals")"
                    DisabledLeft="@(!RobotService.IsConnected)"
                    OnClickLeft="ShowIOSignals"
                    IconRight="Lucide.CircleAlert"
                    LabelRight="@GetErrorButtonLabel()"
                    SublabelRight="@GetErrorButtonSublabel()"
                    DisabledRight="@(!RobotService.IsConnected || !CanClearError)"
                    VariantRight="@(RegisterErrorService.HasActiveError && !RegisterErrorService.IsSelfResettingError ? "danger" : "")"
                    OnClickRight="ClearRegisterError" />

                <!-- Zeile 4: RESET + STOP -->
                <MaintenanceSplitTile
                    IconLeft="Lucide.RefreshCw"
                    LabelLeft="@T.Translate("maintenance.reset")"
                    DisabledLeft="@(!RobotService.IsConnected)"
                    VariantLeft="secondary"
                    OnClickLeft="PerformReset"
                    IconRight="Lucide.Square"
                    LabelRight="@T.Translate("maintenance.programStop")"
                    DisabledRight="@(!RobotService.IsConnected)"
                    VariantRight="danger"
                    OnClickRight="EmergencyStop" />

                <!-- Zeile 5: PC Neustart + Herunterfahren -->
                <MaintenanceSplitTile
                    FullWidth="true"
                    IconLeft="Lucide.RotateCcw"
                    LabelLeft="@T.Translate("maintenance.pcRestart")"
                    OnClickLeft="ShowRestartConfirmation"
                    IconRight="Lucide.Power"
                    LabelRight="@T.Translate("maintenance.pcShutdown")"
                    OnClickRight="ShowShutdownConfirmation" />
            </MaintenanceGrid>
        </div>
    </div>
</div>

<!-- Home Confirmation Dialog -->
<ConfirmationDialog IsVisible="@showHomeDialog"
                   Title="@T.Translate("maintenance.homeDialog.title")"
                   Message="@T.Translate("maintenance.homeDialog.message")"
                   ConfirmText="@T.Translate("maintenance.homeDialog.confirm")"
                   CancelText="@T.Translate("common.cancel")"
                   OnConfirmed="ConfirmGoToHome"
                   OnCancelled="() => showHomeDialog = false" />

<!-- Pick Up Confirmation Dialog -->
<ConfirmationDialog IsVisible="@showPickUpDialog"
                   Title="@T.Translate("maintenance.pickUpDialog.title")"
                   Message="@T.Translate("maintenance.pickUpDialog.message")"
                   ConfirmText="@T.Translate("maintenance.pickUpDialog.confirm")"
                   CancelText="@T.Translate("common.cancel")"
                   OnConfirmed="ConfirmPickUp"
                   OnCancelled="() => showPickUpDialog = false" />

<!-- Lay Down Dialog with workpiece selection -->
<LayDownDialog IsVisible="@showLayDownDialog"
              Title="@T.Translate("maintenance.layDownDialog.title")"
              Message="@T.Translate("maintenance.layDownDialog.message")"
              SelectLabel="@T.Translate("maintenance.layDownDialog.selectLabel")"
              Palette1="@RobotService.Palette1"
              Palette2="@RobotService.Palette2"
              CancelText="@T.Translate("common.cancel")"
              ConfirmTextWithWorkpiece="@T.Translate("maintenance.layDownDialog.confirmWithId")"
              ConfirmTextGeneral="@T.Translate("maintenance.layDownDialog.confirm")"
              OnConfirmed="ConfirmLayDown"
              OnCancelled="() => showLayDownDialog = false" />

<!-- Shutdown Confirmation Dialog -->
<ConfirmationDialog IsVisible="@showShutdownDialog"
                   Title="@T.Translate("maintenance.shutdownDialog.title")"
                   Message="@T.Translate("maintenance.shutdownDialog.message")"
                   ConfirmText="@T.Translate("maintenance.shutdownDialog.confirm")"
                   CancelText="@T.Translate("common.cancel")"
                   ConfirmButtonClass="bg-red-600"
                   OnConfirmed="ConfirmShutdown"
                   OnCancelled="() => showShutdownDialog = false" />

<!-- Restart Confirmation Dialog -->
<ConfirmationDialog IsVisible="@showRestartDialog"
                   Title="@T.Translate("maintenance.restartDialog.title")"
                   Message="@T.Translate("maintenance.restartDialog.message")"
                   ConfirmText="@T.Translate("maintenance.restartDialog.confirm")"
                   CancelText="@T.Translate("common.cancel")"
                   ConfirmButtonClass="bg-blue-600"
                   OnConfirmed="ConfirmRestart"
                   OnCancelled="() => showRestartDialog = false" />

<!-- Shutdown Countdown Dialog -->
<CountdownDialog IsVisible="@showShutdownCountdownDialog"
                Title="@T.Translate("maintenance.shutdownCountdown.title")"
                Message="@T.Translate("maintenance.shutdownCountdown.message", shutdownCountdown)"
                Countdown="@shutdownCountdown"
                Icon="Lucide.Power"
                IconClass="h-6 w-6 text-red-600"
                CountdownClass="text-red-600"
                CancelText="@T.Translate("common.cancel")"
                CancelButtonClass="btn-danger"
                OnCancel="CancelSystemAction" />

<!-- Restart Countdown Dialog -->
<CountdownDialog IsVisible="@showRestartCountdownDialog"
                Title="@T.Translate("maintenance.restartCountdown.title")"
                Message="@T.Translate("maintenance.restartCountdown.message", restartCountdown)"
                Countdown="@restartCountdown"
                Icon="Lucide.RotateCcw"
                IconClass="h-6 w-6 text-blue-600"
                CountdownClass="text-blue-600"
                CancelText="@T.Translate("common.cancel")"
                CancelButtonClass="btn-blue"
                OnCancel="CancelSystemAction" />

<!-- IO Signals Dialog -->
<IoSignalsDialog IsVisible="@showIOSignalsDialog"
                OnClose="() => showIOSignalsDialog = false" />

<!-- Maintenance Exit Dialog -->
<MaintenanceExitDialog IsVisible="@showExitDialog"
                       OnNavigate="ConfirmExit" />
}

@code {
    // Dialog states
    private bool showHomeDialog = false;
    private bool showLayDownDialog = false;
    private bool showPickUpDialog = false;
    private bool showShutdownDialog = false;
    private bool showRestartDialog = false;
    private bool showShutdownCountdownDialog = false;
    private bool showRestartCountdownDialog = false;
    private bool showIOSignalsDialog = false;
    private bool showExitDialog = false;

    // Countdown states
    private int shutdownCountdown = 0;
    private int restartCountdown = 0;
    private System.Threading.Timer? countdownTimer;

    // State
    private bool _isClearingError = false;

    protected override void OnInitialized()
    {
        RobotService.StatusChanged += OnStatusChanged;
        RegisterErrorService.ErrorChanged += OnRegisterErrorChanged;
        T.LanguageChanged += OnLanguageChanged;
    }

    private void OnStatusChanged(object? sender, Laderoboter.Core.Events.RobotStatusChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnRegisterErrorChanged(object? sender, RegisterErrorChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnLanguageChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    // Show dialogs
    private void ShowHomeConfirmation() => showHomeDialog = true;
    private void ShowLayDownConfirmation() => showLayDownDialog = true;
    private void ShowPickUpConfirmation() => showPickUpDialog = true;
    private void ShowShutdownConfirmation() => showShutdownDialog = true;
    private void ShowRestartConfirmation() => showRestartDialog = true;
    private void ShowIOSignals() => showIOSignalsDialog = true;

    // Confirm actions
    private async Task ConfirmGoToHome()
    {
        showHomeDialog = false;
        await RobotService.StopProgramAsync();
        await RobotService.RunProgramAsync("go_to_home");
    }

    private async Task ConfirmPickUp()
    {
        showPickUpDialog = false;
        await RobotService.StopProgramAsync();
        await RobotService.RunProgramAsync("fs_pick_up_ui");
    }

    private async Task ConfirmLayDown(WorkpieceStatus selectedWorkpiece)
    {
        showLayDownDialog = false;

        if (selectedWorkpiece == null || selectedWorkpiece.RegisterAddress == 0)
        {
            return;
        }

        // Stop all running programs
        await RobotService.StopProgramAsync();

        // Wait a moment for the stop to complete
        await Task.Delay(1000);

        // Set Register 175 to workpiece register address and start lay down handshake
        await RobotService.WriteRegisterAsync(175, selectedWorkpiece.RegisterAddress);

        // Then start the lay_down_ui program
        await RobotService.RunProgramAsync("lay_down_ui");
    }

    private async Task ConfirmShutdown()
    {
        showShutdownDialog = false;

        var success = await SystemService.ShutdownAsync(15);
        if (success)
        {
            shutdownCountdown = 15;
            showShutdownCountdownDialog = true;
            StartCountdown("shutdown");
        }
    }

    private async Task ConfirmRestart()
    {
        showRestartDialog = false;

        var success = await SystemService.RestartAsync(15);
        if (success)
        {
            restartCountdown = 15;
            showRestartCountdownDialog = true;
            StartCountdown("restart");
        }
    }

    // Countdown functions
    private void StartCountdown(string type)
    {
        countdownTimer?.Dispose();

        countdownTimer = new System.Threading.Timer(async _ =>
        {
            if (type == "shutdown")
            {
                shutdownCountdown--;
                if (shutdownCountdown <= 0)
                {
                    countdownTimer?.Dispose();
                    showShutdownCountdownDialog = false;
                }
            }
            else if (type == "restart")
            {
                restartCountdown--;
                if (restartCountdown <= 0)
                {
                    countdownTimer?.Dispose();
                    showRestartCountdownDialog = false;
                }
            }
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private async Task CancelSystemAction()
    {
        await SystemService.CancelShutdownAsync();

        countdownTimer?.Dispose();
        showShutdownCountdownDialog = false;
        showRestartCountdownDialog = false;
        shutdownCountdown = 0;
        restartCountdown = 0;
    }

    // Door control - Handshake wird im Core überwacht
    private async Task ToggleMaintenanceDoor()
    {
        // Wartungstür: R189 → Core überwacht R89 und setzt R189 zurück
        await RobotService.StartDoorHandshakeAsync(189);
    }

    private async Task OpenLoadDoor()
    {
        await RobotService.StopProgramAsync();
        await RobotService.RunProgramAsync("open_door");
    }

    private async Task CloseLoadDoor()
    {
        await RobotService.StopProgramAsync();
        await RobotService.RunProgramAsync("close_door");
    }

    private async Task TogglePaletteDoor(int number)
    {
        int requestRegister = number == 1 ? 187 : 188;
        // Palettentür: R187/R188 → Core überwacht R87/R88 und setzt zurück
        await RobotService.StartDoorHandshakeAsync(requestRegister);
    }

    // Robot control
    private async Task PerformReset()
    {
        await RobotService.ResetAsync();
    }

    private async Task EmergencyStop()
    {
        await RobotService.StopProgramAsync();
    }

    private async Task ClearRegisterError()
    {
        if (_isClearingError || !RegisterErrorService.HasActiveError)
            return;

        _isClearingError = true;
        StateHasChanged();

        try
        {
            await RegisterErrorService.ClearErrorAsync();
        }
        finally
        {
            _isClearingError = false;
            StateHasChanged();
        }
    }

    // Self-resetting errors cannot be cleared manually
    private bool CanClearError => RegisterErrorService.HasActiveError && !RegisterErrorService.IsSelfResettingError;

    private string GetErrorButtonLabel()
    {
        if (_isClearingError)
            return T.Translate("maintenance.clearingError");

        if (RegisterErrorService.HasActiveError)
            return T.Translate("maintenance.clearError");

        return T.Translate("maintenance.noError");
    }

    private string? GetErrorButtonSublabel()
    {
        if (RegisterErrorService.HasActiveError && !_isClearingError)
            return RegisterErrorService.CurrentErrorMessage;

        return null;
    }

    private void NavigateBack()
    {
        // Zeige Exit-Dialog wenn Roboter verbunden ist
        if (RobotService.IsConnected)
        {
            showExitDialog = true;
        }
        else
        {
            Navigation.NavigateTo("/");
        }
    }

    private void ConfirmExit()
    {
        showExitDialog = false;
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        RobotService.StatusChanged -= OnStatusChanged;
        RegisterErrorService.ErrorChanged -= OnRegisterErrorChanged;
        T.LanguageChanged -= OnLanguageChanged;
        countdownTimer?.Dispose();
    }
}
